---
import '@fontsource/fusion-pixel-12px-proportional-kr';
import '../mystery-emblem/ui/pmdWindow.css';

const title = 'Mystery Emblem — Tactical RPG';
const description =
  'A browser-based tactical RPG combining Fire Emblem Awakening gameplay systems with Pokémon Mystery Dungeon: Explorers of Sky visuals.';
const canonicalUrl = Astro.url.href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <link rel="icon" type="image/png" sizes="84x84" href={`${import.meta.env.BASE_URL}favicon.png`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}favicon.png`} />
    <title>{title}</title>
  </head>
  <body>
    <main class="mystery-emblem-shell">
      <div id="mystery-emblem-root" class="pmd-viewport">
        <!-- Full-Bleed Mystery Emblem Box Art Backdrop (Shown on Landing Title Screen) -->
        <div
          id="pmd-landing-backdrop"
          class="pmd-landing-backdrop"
          data-testid="landing-backdrop"
          aria-hidden="true"
        >
          <img
            class="pmd-landing-art"
            data-testid="landing-boxart"
            src={`${import.meta.env.BASE_URL}boxart.png`}
            alt=""
            decoding="async"
          />
        </div>

        <!-- Admin-Only Dev Tools Button (Top-Left, strictly visible ONLY for ADMIN_DEVTOOLS_EMAILS) -->
        <button
          id="pmd-dev-tools-btn"
          class="pmd-window pmd-window--compact pmd-corner-btn pmd-corner-left"
          type="button"
          hidden
        >
          Dev Tools
        </button>

        <!-- Persistent Top-Right Corner Button: Google Log In / Log Out on Title; Menu / Back in Scenes -->
        <button
          id="pmd-corner-menu-btn"
          class="pmd-window pmd-window--compact pmd-corner-btn pmd-corner-right"
          type="button"
          data-corner-mode="login"
          aria-label="Log in with Google"
        >
          <svg
            class="pmd-google-g-icon"
            data-testid="google-g-icon"
            viewBox="0 0 24 24"
            width="16"
            height="16"
            aria-hidden="true"
          >
            <path
              fill="#4285F4"
              d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
            ></path>
            <path
              fill="#34A853"
              d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
            ></path>
            <path
              fill="#FBBC05"
              d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"
            ></path>
            <path
              fill="#EA4335"
              d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
            ></path>
          </svg>
          <span>Log In</span>
        </button>

        <!-- Authentic PMD: Explorers of Sky Compact Start/Continue Window Over Box Art -->
        <section id="pmd-title-screen" class="pmd-window pmd-title-card">
          <h1 class="pmd-title pmd-sr-only">MYSTERY EMBLEM</h1>
          <div class="pmd-actions pmd-menu-list">
            <button
              class="pmd-btn pmd-btn-primary pmd-menu-row pmd-continue-btn"
              id="btn-continue"
              type="button"
            >
              <span id="btn-continue-label">Start</span>
              <span
                id="btn-continue-chapter"
                class="pmd-continue-chapter"
                data-testid="continue-chapter-badge"
                hidden
              ></span>
            </button>
          </div>
          <p id="pmd-status-msg" class="pmd-status" aria-live="polite" hidden></p>
        </section>

        <!-- Admin-Only Dev Tools Overlay Modal (Strictly accessible ONLY for ADMIN_DEVTOOLS_EMAILS) -->
        <div
          id="pmd-devtools-backdrop"
          class="pmd-devtools-backdrop"
          data-testid="devtools-backdrop"
          hidden
        >
          <section
            id="pmd-devtools-modal"
            class="pmd-window pmd-panel"
            role="dialog"
            aria-modal="true"
            aria-label="Admin Dev Tools"
          ></section>
        </div>
      </div>
    </main>
  </body>
</html>

<script>
  import { resetSpriteWidgets } from '../utils/sprite-utils';
  import {
    PMD_PORTRAIT_EMOTIONS,
    PMD_SPRITE_ACTIONS,
    clearPmdAssetCache,
    computePmdTileSpritePlacement,
    loadSpeciesPortrait,
    loadSpeciesSpriteBundle,
  } from '../mystery-emblem/assets/pmdAssetLoader';
  import {
    PMD_TILESET_LIST,
    clearTilesetCache,
    loadTilesetSheet,
  } from '../mystery-emblem/assets/tilesetLoader';
  import { getAudioManager } from '../mystery-emblem/audio/AudioManager';
  import {
    ADMIN_DEVTOOLS_EMAILS,
    hasAdminDevToolsAccess,
  } from '../mystery-emblem/data/accessControl';
  import {
    getRegistryValidationSummary,
    getSpeciesById,
  } from '../mystery-emblem/data/index';
  import {
    computeEnemyDangerArea,
    computeUnitMovementAndAttackRange,
    findShortestPathAStar,
    getTerrainBonuses,
    getTerrainMoveCost,
  } from '../mystery-emblem/engine/terrainAndPathfinding';
  import {
    computeCombatForecast,
    computeHealForecast,
    computeUnitPopupStats,
    getTypeEffectiveness,
    resolveCombatExchange,
  } from '../mystery-emblem/engine/combatEngine';
  import { chooseEnemyAction } from '../mystery-emblem/engine/enemyAi';
  import {
    awardBattleUnitExp,
    computeCombatExpGain,
    computeSupportHealExpGain,
    getEligibleEvolutionBranches,
    promoteBattleUnitMidBattle,
  } from '../mystery-emblem/engine/progressionEngine';
  import {
    DEMO_CAMPAIGN_CHAPTERS,
    DEMO_INITIAL_CONVOY,
    DEMO_STARTING_LEVEL,
    getDemoChapterByNodeId,
    type CampaignChapterConfig,
  } from '../mystery-emblem/data/campaignRegistry';
  import {
    DRAGON_LORD_OPTIONS,
    PERSONALITY_QUIZ_QUESTIONS,
    evaluatePersonalityQuiz,
    getStarterPartnerOptions,
  } from '../mystery-emblem/data/quizData';
  import {
    CHAPTER_LEVEL_CATALOG,
    exportChapterMapJson,
    getDefaultChapterMap,
    getEffectiveChapterMap,
    hasChapterMapOverride,
    importChapterMapJson,
    reloadChapterMapsFromStorage,
    resetAllChapterMapOverrides,
    resetChapterMapOverride,
    saveChapterMapOverride,
  } from '../mystery-emblem/data/chapterMapRegistry';
  import { BattleScene } from '../mystery-emblem/scenes/BattleScene';
  import { ChapterMapEditorScene } from '../mystery-emblem/scenes/ChapterMapEditorScene';
  import { OverworldScene } from '../mystery-emblem/scenes/OverworldScene';
  import {
    DEMO_OVERWORLD_GRAPH,
    buildKecleonShopInventory,
    buildSkirmishBattlePayload,
  } from '../mystery-emblem/data/overworldMapData';
  import {
    findOverworldRoute,
    rollPostBattleOverworldSpawns,
    samplePolylineAtDistance,
  } from '../mystery-emblem/engine/overworldEngine';
  import {
    InMemoryCloudSyncAdapter,
    type CloudSyncAdapter,
  } from '../mystery-emblem/state/firebaseSync';
  import {
    SaveStateManager,
    formatCampaignChapterLabel,
    getUnitEquippedItemId,
  } from '../mystery-emblem/state/SaveStateManager';
  import { DevToolsHarness } from '../mystery-emblem/ui/DevToolsHarness';
  import { DialogueOverlay } from '../mystery-emblem/ui/DialogueOverlay';
  import { QuizScene, RecruitNicknameOverlay } from '../mystery-emblem/ui/QuizScene';
  import {
    PmdPortraitView,
    PmdSpriteActor,
    destroyAllPmdSpriteActors,
  } from '../mystery-emblem/ui/PmdSpriteCanvas';
  import {
    BackStackController,
    bindBackGestureSurface,
    bindPointerTap,
  } from '../mystery-emblem/ui/pointerControls';

  const GOOGLE_G_SVG_MARKUP = `<svg class="pmd-google-g-icon" data-testid="google-g-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"></path><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"></path><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"></path><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"></path></svg>`;

  let currentManager: SaveStateManager | null = null;
  let currentDialogueOverlay: DialogueOverlay | null = null;
  let currentRecruitNicknameOverlay: RecruitNicknameOverlay | null = null;
  let currentQuizScene: QuizScene | null = null;
  let currentDevToolsHarness: DevToolsHarness | null = null;
  let currentBattleScene: BattleScene | null = null;
  let currentMapEditorScene: ChapterMapEditorScene | null = null;
  let currentOverworldScene: OverworldScene | null = null;
  let uiAbortController: AbortController | null = null;

  async function initMysteryEmblemApp() {
    resetSpriteWidgets();
    destroyAllPmdSpriteActors();
    currentBattleScene?.destroy();
    currentBattleScene = null;
    currentMapEditorScene?.destroy();
    currentMapEditorScene = null;
    currentOverworldScene?.destroy();
    currentOverworldScene = null;
    currentQuizScene?.destroy();
    currentQuizScene = null;
    currentRecruitNicknameOverlay?.destroy();
    currentRecruitNicknameOverlay = null;
    currentDevToolsHarness?.destroy();
    currentDevToolsHarness = null;
    currentDialogueOverlay?.destroy();
    currentDialogueOverlay = null;
    currentManager?.dispose();
    uiAbortController?.abort();
    uiAbortController = new AbortController();
    const signal = uiAbortController.signal;

    reloadChapterMapsFromStorage();

    const injectedAdapter = (window as unknown as Record<string, unknown>)
      .__MYSTERY_EMBLEM_TEST_CLOUD_ADAPTER__ as CloudSyncAdapter | undefined;

    const manager = new SaveStateManager(undefined, injectedAdapter);
    currentManager = manager;
    const audioManager = getAudioManager();

    const viewportEl = document.getElementById('mystery-emblem-root');
    const landingBackdrop = document.getElementById('pmd-landing-backdrop');
    const titleScreen = document.getElementById('pmd-title-screen');
    const devToolsBackdrop = document.getElementById('pmd-devtools-backdrop');
    const devToolsModal = document.getElementById('pmd-devtools-modal');
    const devToolsBtn = document.getElementById('pmd-dev-tools-btn');
    const cornerMenuBtn = document.getElementById('pmd-corner-menu-btn') as HTMLButtonElement | null;
    const statusMsgEl = document.getElementById('pmd-status-msg');

    const btnContinue = document.getElementById('btn-continue') as HTMLButtonElement | null;
    const btnContinueLabel = document.getElementById('btn-continue-label');
    const btnContinueChapter = document.getElementById('btn-continue-chapter');

    let battleScene: BattleScene | null = null;
    let battleReturnTarget: 'devtools' | 'overworld' | 'title' = 'overworld';
    let overworldScene: OverworldScene | null = null;
    let overworldReturnTarget: 'title' | 'suppress' = 'title';
    let pendingDemoOutroChapter: CampaignChapterConfig | null = null;
    let demoLaunchInProgress = false;
    let mapEditorScene: ChapterMapEditorScene | null = null;

    function isAdminSignedIn(): boolean {
      const email = manager.getSyncStatus().user?.email;
      return hasAdminDevToolsAccess(email);
    }

    function isDevToolsOpen(): boolean {
      return Boolean(devToolsBackdrop && !devToolsBackdrop.hidden);
    }

    function closeDevToolsOverlay(): void {
      if (!devToolsBackdrop) return;
      devToolsBackdrop.hidden = true;
      const anySceneOpen =
        Boolean(battleScene?.isOpen()) ||
        Boolean(overworldScene?.isOpen()) ||
        Boolean(mapEditorScene?.isOpen()) ||
        Boolean(quizScene?.isOpen());
      if (!anySceneOpen && titleScreen) {
        titleScreen.hidden = false;
      }
      backStack.syncButtonLabel();
    }

    function openDevToolsOverlay(tab?: 'cheats' | 'maps'): void {
      if (!isAdminSignedIn() || !devToolsBackdrop) return;
      devToolsBackdrop.hidden = false;
      currentDevToolsHarness?.onSaveChanged();
      if (tab) {
        currentDevToolsHarness?.switchSubTab(tab);
      }
      backStack.syncButtonLabel();
    }

    function toggleDevTools(): void {
      if (!isAdminSignedIn() || !devToolsBackdrop) return;
      if (isDevToolsOpen()) {
        audioManager.playSfx('cancel');
        closeDevToolsOverlay();
      } else {
        audioManager.playSfx('select');
        openDevToolsOverlay();
      }
    }

    const backStack = new BackStackController(
      cornerMenuBtn,
      () => {
        if (battleScene?.isOpen()) {
          battleScene.handleMenuOrBack();
          return;
        }
        if (overworldScene?.isOpen()) {
          overworldScene.handleMenuOrBack();
          return;
        }
        if (mapEditorScene?.isOpen()) {
          mapEditorScene.handleMenuOrBack();
          return;
        }
      },
      {
        syncIdleButton: (btn) => {
          if (
            battleScene?.isOpen() ||
            mapEditorScene?.isOpen() ||
            overworldScene?.isOpen()
          ) {
            btn.textContent = 'Menu';
            btn.dataset.cornerMode = 'menu';
            btn.setAttribute('aria-label', 'Open System Menu');
            btn.removeAttribute('title');
            return;
          }

          const sync = manager.getSyncStatus();
          if (sync.user) {
            const who = sync.user.email ?? sync.user.displayName ?? 'Google Account';
            btn.innerHTML = `${GOOGLE_G_SVG_MARKUP}<span>Log Out</span>`;
            btn.dataset.cornerMode = 'logout';
            btn.setAttribute('aria-label', `Signed in as ${who} — Log out`);
            btn.setAttribute('title', `Signed in as ${who}`);
          } else {
            btn.innerHTML = `${GOOGLE_G_SVG_MARKUP}<span>Log In</span>`;
            btn.dataset.cornerMode = 'login';
            btn.setAttribute('aria-label', 'Log in with Google');
            btn.removeAttribute('title');
          }
        },
      }
    );

    function syncLandingBackdrop(): void {
      if (!landingBackdrop) return;
      const inGameplayScene =
        Boolean(battleScene?.isOpen()) ||
        Boolean(mapEditorScene?.isOpen()) ||
        Boolean(overworldScene?.isOpen()) ||
        Boolean(quizScene?.isOpen());
      landingBackdrop.hidden = inGameplayScene || Boolean(titleScreen?.hidden);
    }

    const origSyncButtonLabel = backStack.syncButtonLabel.bind(backStack);
    backStack.syncButtonLabel = () => {
      syncLandingBackdrop();
      origSyncButtonLabel();
    };

    const dialogueOverlay = viewportEl
      ? new DialogueOverlay(viewportEl, manager, {
          onStateChange: () => backStack.syncButtonLabel(),
          audioManager,
        })
      : null;
    currentDialogueOverlay = dialogueOverlay;

    const recruitNicknameOverlay = viewportEl
      ? new RecruitNicknameOverlay(viewportEl, manager, {
          audioManager,
          onStateChange: () => backStack.syncButtonLabel(),
        })
      : null;
    currentRecruitNicknameOverlay = recruitNicknameOverlay;

    const quizScene =
      viewportEl && recruitNicknameOverlay
        ? new QuizScene(viewportEl, manager, recruitNicknameOverlay, {
            audioManager,
            onCancel: () => showTitleScreen(),
            onStateChange: () => backStack.syncButtonLabel(),
          })
        : null;
    currentQuizScene = quizScene;

    function showTitleScreen(): void {
      if (devToolsBackdrop) devToolsBackdrop.hidden = true;
      if (titleScreen) titleScreen.hidden = false;
      backStack.syncButtonLabel();
    }

    async function openBattleScene(
      source: 'devtools' | 'overworld' = 'devtools',
      levelId = 'prologue'
    ): Promise<void> {
      if (!battleScene) return;
      if (source === 'devtools' && !isAdminSignedIn()) return;
      if (overworldScene?.isOpen()) {
        overworldReturnTarget = 'suppress';
        overworldScene.close();
      }
      if (mapEditorScene?.isOpen()) {
        mapEditorScene.close();
      }
      if (quizScene?.isOpen()) {
        quizScene.close();
      }
      battleReturnTarget = source;
      if (titleScreen) titleScreen.hidden = true;
      if (devToolsBackdrop) devToolsBackdrop.hidden = true;
      await battleScene.open({ levelId });
      backStack.syncButtonLabel();
    }

    async function openOverworldScene(opts?: {
      preservePosition?: boolean;
    }): Promise<void> {
      if (!overworldScene) return;
      overworldReturnTarget = 'title';

      if (!manager.getSave()) {
        manager.createNewCampaignSave({
          campaignMode: 'demo',
          lordSpeciesId: 'dratini',
          lordNickname: 'Bahamut',
          partnerSpeciesId: 'bulbasaur',
          partnerNickname: 'Sprout',
          healerSpeciesId: 'happiny',
          healerNickname: 'Clover',
          startingLevel: DEMO_STARTING_LEVEL,
          scaleStatsToLevel: true,
          initialConvoy: DEMO_INITIAL_CONVOY,
          overworldGraph: DEMO_OVERWORLD_GRAPH,
        });
      }

      if (titleScreen) titleScreen.hidden = true;
      if (devToolsBackdrop) devToolsBackdrop.hidden = true;
      await overworldScene.open({
        graph: DEMO_OVERWORLD_GRAPH,
        preservePosition: opts?.preservePosition ?? true,
      });
      backStack.syncButtonLabel();

      if (pendingDemoOutroChapter) {
        const outroChapter = pendingDemoOutroChapter;
        pendingDemoOutroChapter = null;
        if (dialogueOverlay && !manager.hasSeenChapterCutscene('outro', outroChapter.nodeId)) {
          await dialogueOverlay.playScript(outroChapter.buildOutroScript(manager.getSave()));
          manager.markChapterCutsceneSeen('outro', outroChapter.nodeId);
          if (overworldScene.isOpen()) {
            audioManager.playBgm('exploration_theme', { fadeMs: 260 });
          }
          backStack.syncButtonLabel();
        }
      }
    }

    function openDemoQuizFlow(opts?: { skipNicknamePrompts?: boolean; forceNgPlus?: boolean }): void {
      if (!quizScene) return;
      if (overworldScene?.isOpen()) {
        overworldReturnTarget = 'suppress';
        overworldScene.close();
      }
      if (battleScene?.isOpen()) {
        battleReturnTarget = 'title';
        battleScene.close();
      }
      if (titleScreen) titleScreen.hidden = true;
      if (devToolsBackdrop) devToolsBackdrop.hidden = true;
      quizScene.open({
        campaignMode: 'demo',
        startingLevel: DEMO_STARTING_LEVEL,
        scaleStatsToLevel: true,
        initialConvoy: DEMO_INITIAL_CONVOY,
        overworldGraph: DEMO_OVERWORLD_GRAPH,
        skipNicknamePrompts: opts?.skipNicknamePrompts,
        forceNgPlus: opts?.forceNgPlus,
        onComplete: () => {
          void openOverworldScene({ preservePosition: false });
        },
      });
      backStack.syncButtonLabel();
    }

    async function launchDemoChapterBattle(demoChapter: CampaignChapterConfig): Promise<void> {
      if (!battleScene || demoLaunchInProgress) return;
      demoLaunchInProgress = true;
      try {
        // 1. Pre-battle quiz-seeded unit recruitment (with Nickname prompt)
        if (demoChapter.recruitment && !manager.hasRecruitedChapter(demoChapter.nodeId)) {
          const saveSnap = manager.getSave();
          const seededSpecies =
            saveSnap?.campaign.quizSeeds?.[demoChapter.recruitment.seedKey] ?? [];
          const targetSpeciesIds =
            seededSpecies.length > 0
              ? seededSpecies
              : demoChapter.recruitment.fallbackSpeciesIds;
          const newlyRecruited = [];
          for (const spId of targetSpeciesIds) {
            const sp = getSpeciesById(spId);
            if (!sp) continue;
            const alreadyOwned = manager.getSave()?.roster.some((u) => {
              const uSp = getSpeciesById(u.speciesId);
              return uSp?.lineId === sp.lineId;
            });
            if (alreadyOwned) continue;
            const joined = manager.recruitPokemon({
              speciesId: spId,
              level: demoChapter.recruitment.joinLevel,
              scaleStatsToLevel: demoChapter.recruitment.scaleStatsToLevel,
            });
            newlyRecruited.push(joined);
          }
          manager.markChapterRecruited(demoChapter.nodeId);
          if (newlyRecruited.length > 0 && recruitNicknameOverlay) {
            await recruitNicknameOverlay.promptRecruits(newlyRecruited, {
              bannerText: demoChapter.recruitment.introBanner,
            });
          }
        }

        // 2. Pre-battle Intro Portrait Cutscene
        if (dialogueOverlay && !manager.hasSeenChapterCutscene('intro', demoChapter.nodeId)) {
          const introScript = demoChapter.buildIntroScript(manager.getSave());
          await dialogueOverlay.playScript(introScript);
          manager.markChapterCutsceneSeen('intro', demoChapter.nodeId);
        }

        // 3. Transition from Overworld into Dungeon Prep + Battle
        overworldReturnTarget = 'suppress';
        overworldScene?.close();
        battleReturnTarget = 'overworld';
        if (titleScreen) titleScreen.hidden = true;
        if (devToolsBackdrop) devToolsBackdrop.hidden = true;

        await battleScene.open({
          levelId: demoChapter.levelId,
          customMap: demoChapter.buildMap(),
          enemyOverrides: demoChapter.enemySpawns,
          objectiveType: demoChapter.objectiveType,
          objectiveLabel: demoChapter.objectiveLabel,
          reinforcements: demoChapter.reinforcements,
          commitToSaveOnVictory: true,
          clearRewardItems: demoChapter.clearRewardItems,
          exitButtonLabel: 'Return to World Map',
          hideReplayOnVictory: true,
          onVictory: () => {
            manager.completeOverworldChapter(demoChapter.nodeId, {
              graph: DEMO_OVERWORLD_GRAPH,
            });
            if (demoChapter.guaranteesKecleonShopOnClear) {
              manager.spawnOverworldKecleonShop(
                demoChapter.guaranteesKecleonShopOnClear.nodeId,
                demoChapter.guaranteesKecleonShopOnClear.shopType,
                Math.random,
                DEMO_OVERWORLD_GRAPH
              );
            }
            if (demoChapter.isDemoFinale) {
              manager.markDemoCompleted();
              manager.setNewGamePlusUnlocked(true);
            }
            if (!manager.hasSeenChapterCutscene('outro', demoChapter.nodeId)) {
              pendingDemoOutroChapter = demoChapter;
            }
          },
        });
        backStack.syncButtonLabel();
      } finally {
        demoLaunchInProgress = false;
      }
    }

    async function openMapEditor(levelId = 'prologue'): Promise<void> {
      if (!mapEditorScene || !isAdminSignedIn()) return;
      if (overworldScene?.isOpen()) {
        overworldReturnTarget = 'suppress';
        overworldScene.close();
      }
      if (battleScene?.isOpen()) {
        battleReturnTarget = 'title';
        battleScene.close();
      }
      if (quizScene?.isOpen()) {
        quizScene.close();
      }
      if (titleScreen) titleScreen.hidden = true;
      if (devToolsBackdrop) devToolsBackdrop.hidden = true;
      await mapEditorScene.open(levelId);
      backStack.syncButtonLabel();
    }

    async function promptRenameUnit(
      instanceId: string,
      overrideManager?: SaveStateManager
    ): Promise<void> {
      if (!recruitNicknameOverlay) return;
      await recruitNicknameOverlay.promptRenameUnit(instanceId, overrideManager);
      battleScene?.refreshFromExternalSaveCheat();
      currentDevToolsHarness?.onSaveChanged();
    }

    if (viewportEl) {
      battleScene = new BattleScene({
        viewportEl,
        saveManager: manager,
        audioManager,
        onRequestRenameUnit: (instanceId) =>
          promptRenameUnit(instanceId, battleScene?.getPrepSaveManager()),
        onExit: () => {
          if (battleReturnTarget === 'devtools' && isAdminSignedIn()) {
            if (manager.getSave()) {
              void openOverworldScene({ preservePosition: true }).then(() => {
                openDevToolsOverlay('maps');
              });
            } else {
              showTitleScreen();
              openDevToolsOverlay('maps');
            }
          } else if (battleReturnTarget === 'overworld') {
            void openOverworldScene({ preservePosition: true });
          } else {
            showTitleScreen();
          }
        },
        onLayerStateChanged: () => backStack.syncButtonLabel(),
      });
      currentBattleScene = battleScene;

      mapEditorScene = new ChapterMapEditorScene({
        viewportEl,
        saveManager: manager,
        audioManager,
        onExit: () => {
          if (isAdminSignedIn()) {
            if (manager.getSave()) {
              void openOverworldScene({ preservePosition: true }).then(() => {
                openDevToolsOverlay('maps');
              });
            } else {
              showTitleScreen();
              openDevToolsOverlay('maps');
            }
          } else {
            showTitleScreen();
          }
        },
        onPlayLevel: (targetLevelId) => {
          void openBattleScene('devtools', targetLevelId);
        },
        onLayerStateChanged: () => backStack.syncButtonLabel(),
      });
      currentMapEditorScene = mapEditorScene;

      overworldScene = new OverworldScene({
        viewportEl,
        saveManager: manager,
        audioManager,
        onExit: () => {
          if (overworldReturnTarget === 'suppress') {
            return;
          }
          showTitleScreen();
        },
        onLayerStateChanged: () => backStack.syncButtonLabel(),
        onRequestRenameUnit: (instanceId) => void promptRenameUnit(instanceId),
        onRequestNewGame: () => openDemoQuizFlow(),
        onLaunchChapterBattle: ({ nodeId, levelId }) => {
          if (!battleScene) return;
          const demoChapter = getDemoChapterByNodeId(nodeId);
          if (demoChapter) {
            void launchDemoChapterBattle(demoChapter);
            return;
          }
          overworldReturnTarget = 'suppress';
          overworldScene?.close();
          battleReturnTarget = 'overworld';
          if (titleScreen) titleScreen.hidden = true;
          if (devToolsBackdrop) devToolsBackdrop.hidden = true;
          void battleScene
            .open({
              levelId,
              commitToSaveOnVictory: true,
              exitButtonLabel: 'Return to World Map',
              hideReplayOnVictory: true,
              onVictory: () => {
                manager.completeOverworldChapter(nodeId, {
                  graph: DEMO_OVERWORLD_GRAPH,
                });
              },
            })
            .then(() => backStack.syncButtonLabel());
        },
        onLaunchSkirmishBattle: ({ nodeId, customMap, enemyOverrides, goldBounty }) => {
          if (!battleScene) return;
          overworldReturnTarget = 'suppress';
          overworldScene?.close();
          battleReturnTarget = 'overworld';
          if (titleScreen) titleScreen.hidden = true;
          if (devToolsBackdrop) devToolsBackdrop.hidden = true;
          void battleScene
            .open({
              customMap,
              enemyOverrides,
              commitToSaveOnVictory: true,
              exitButtonLabel: 'Return to World Map',
              hideReplayOnVictory: true,
              onVictory: () => {
                manager.clearOverworldSkirmish(
                  nodeId,
                  goldBounty,
                  DEMO_OVERWORLD_GRAPH
                );
              },
            })
            .then(() => backStack.syncButtonLabel());
        },
      });
      currentOverworldScene = overworldScene;
    }

    if (devToolsModal) {
      currentDevToolsHarness = new DevToolsHarness({
        modalEl: devToolsModal,
        saveManager: manager,
        audioManager,
        isBattleOpen: () => Boolean(battleScene?.isOpen()),
        onCheatFullHealSquad: () => battleScene?.cheatFullHealSquad(),
        onCheatInstantWin: () => battleScene?.cheatInstantWin(),
        onLiveStateMutated: (opts) => {
          if (opts?.snapOverworld && overworldScene?.isOpen()) {
            overworldScene.snapToCurrentSaveNode();
          }
          battleScene?.refreshFromExternalSaveCheat();
        },
        onLaunchMapEditor: (levelId) => {
          void openMapEditor(levelId);
        },
        onPlayMapBattle: (levelId) => {
          void openBattleScene('devtools', levelId);
        },
        onRequestRenameUnit: (instanceId) => {
          void promptRenameUnit(instanceId);
        },
        onClose: () => closeDevToolsOverlay(),
        signal,
      });
    }

    // Close Dev Tools when clicking backdrop outside modal
    devToolsBackdrop?.addEventListener(
      'pointerdown',
      (ev: PointerEvent) => {
        if (ev.target === devToolsBackdrop) {
          ev.stopPropagation();
          audioManager.playSfx('cancel');
          closeDevToolsOverlay();
        }
      },
      { signal }
    );
    devToolsModal?.addEventListener(
      'pointerdown',
      (ev: PointerEvent) => {
        ev.stopPropagation();
      },
      { signal }
    );

    (window as unknown as Record<string, unknown>).__MYSTERY_EMBLEM_DEBUG__ = {
      saveManager: manager,
      SaveStateManager,
      formatCampaignChapterLabel,
      getUnitEquippedItemId,
      ADMIN_DEVTOOLS_EMAILS,
      hasAdminDevToolsAccess,
      InMemoryCloudSyncAdapter,
      getRegistryValidationSummary,
      audioManager,
      dialogueOverlay,
      recruitNicknameOverlay,
      quizScene,
      openDemoQuizFlow,
      launchDemoChapterBattle,
      devToolsHarness: currentDevToolsHarness,
      battleScene,
      openBattleScene,
      mapEditorScene,
      openMapEditor,
      overworldScene,
      openOverworldScene,
      DEMO_OVERWORLD_GRAPH,
      DEMO_CAMPAIGN_CHAPTERS,
      DEMO_STARTING_LEVEL,
      DEMO_INITIAL_CONVOY,
      getDemoChapterByNodeId,
      DRAGON_LORD_OPTIONS,
      PERSONALITY_QUIZ_QUESTIONS,
      evaluatePersonalityQuiz,
      getStarterPartnerOptions,
      awardBattleUnitExp,
      computeCombatExpGain,
      computeSupportHealExpGain,
      getEligibleEvolutionBranches,
      promoteBattleUnitMidBattle,
      buildKecleonShopInventory,
      buildSkirmishBattlePayload,
      findOverworldRoute,
      samplePolylineAtDistance,
      rollPostBattleOverworldSpawns,
      CHAPTER_LEVEL_CATALOG,
      getDefaultChapterMap,
      getEffectiveChapterMap,
      hasChapterMapOverride,
      saveChapterMapOverride,
      resetChapterMapOverride,
      resetAllChapterMapOverrides,
      exportChapterMapJson,
      importChapterMapJson,
      promptRenameUnit,
      computeCombatForecast,
      computeUnitPopupStats,
      computeHealForecast,
      resolveCombatExchange,
      getTypeEffectiveness,
      chooseEnemyAction,
      loadSpeciesSpriteBundle,
      loadSpeciesPortrait,
      clearPmdAssetCache,
      computePmdTileSpritePlacement,
      PmdSpriteActor,
      PmdPortraitView,
      PMD_SPRITE_ACTIONS,
      PMD_PORTRAIT_EMOTIONS,
      PMD_TILESET_LIST,
      loadTilesetSheet,
      clearTilesetCache,
      getTerrainMoveCost,
      getTerrainBonuses,
      computeUnitMovementAndAttackRange,
      findShortestPathAStar,
      computeEnemyDangerArea,
    };

    function setStatus(msg: string): void {
      if (!statusMsgEl) return;
      const trimmed = msg.trim();
      statusMsgEl.textContent = trimmed;
      statusMsgEl.hidden = trimmed.length === 0;
    }

    // Register navigation layers from lowest to highest LIFO priority
    backStack.registerLayer({
      id: 'battle-scene-sublayer',
      isActive: () => Boolean(battleScene?.isOpen() && battleScene.hasActiveSubLayer()),
      onBack: () => battleScene?.handleMenuOrBack(),
    });
    backStack.registerLayer({
      id: 'map-editor-sublayer',
      isActive: () => Boolean(mapEditorScene?.isOpen() && mapEditorScene.hasActiveSubLayer()),
      onBack: () => mapEditorScene?.handleMenuOrBack(),
    });
    backStack.registerLayer({
      id: 'overworld-scene-sublayer',
      isActive: () => Boolean(overworldScene?.isOpen() && overworldScene.hasActiveSubLayer()),
      onBack: () => overworldScene?.handleMenuOrBack(),
    });
    backStack.registerLayer({
      id: 'quiz-scene',
      isActive: () => Boolean(quizScene?.isOpen()),
      onBack: () => quizScene?.handleBack(),
    });
    backStack.registerLayer({
      id: 'devtools-modal',
      isActive: () => isDevToolsOpen(),
      onBack: () => {
        audioManager.playSfx('cancel');
        closeDevToolsOverlay();
      },
    });
    backStack.registerLayer({
      id: 'dialogue-overlay',
      isActive: () => Boolean(dialogueOverlay?.isOpen()),
      onBack: () => dialogueOverlay?.close('cancelled'),
    });
    backStack.registerLayer({
      id: 'recruit-nickname-modal',
      isActive: () => Boolean(recruitNicknameOverlay?.isOpen()),
      onBack: () => recruitNicknameOverlay?.handleBack(),
    });

    function renderAll(): void {
      const save = manager.getSave();
      const adminActive = isAdminSignedIn();

      if (!audioManager.getCurrentTrackId()) {
        audioManager.playBgm('top_menu', { fadeMs: 350 });
      }

      const anySceneOpen =
        Boolean(quizScene?.isOpen()) ||
        Boolean(recruitNicknameOverlay?.isOpen()) ||
        Boolean(dialogueOverlay?.isOpen()) ||
        Boolean(battleScene?.isOpen()) ||
        Boolean(mapEditorScene?.isOpen()) ||
        Boolean(overworldScene?.isOpen());
      if (!anySceneOpen && titleScreen) {
        titleScreen.hidden = false;
      }

      if (devToolsBtn) {
        devToolsBtn.hidden = !adminActive;
      }
      if (!adminActive) {
        if (mapEditorScene?.isOpen()) {
          mapEditorScene.close();
        }
        if (isDevToolsOpen()) {
          closeDevToolsOverlay();
        }
      }

      if (save) {
        const chapterLabel = formatCampaignChapterLabel(save.campaign.currentChapterId);
        if (btnContinueLabel) {
          btnContinueLabel.textContent = 'Continue';
        }
        if (btnContinueChapter) {
          btnContinueChapter.textContent = chapterLabel;
          btnContinueChapter.hidden = false;
        }
      } else {
        if (btnContinueLabel) {
          btnContinueLabel.textContent = 'Start';
        }
        if (btnContinueChapter) {
          btnContinueChapter.textContent = '';
          btnContinueChapter.hidden = true;
        }
      }

      currentDevToolsHarness?.onSaveChanged();
      backStack.syncButtonLabel();
    }

    // Top-Right Corner Button:
    // - In `back` / `menu` mode: unified pointer tap
    // - In `login` / `logout` mode (Title Screen): native `click` activation so iOS Safari & Android Chrome permit `signInWithPopup`
    let cornerPressedInNavMode = false;
    cornerMenuBtn?.addEventListener(
      'pointerdown',
      (ev: PointerEvent) => {
        if (ev.button !== 0 && ev.pointerType === 'mouse') return;
        ev.stopPropagation();
        const mode = cornerMenuBtn.dataset.cornerMode;
        cornerPressedInNavMode = mode === 'back' || mode === 'menu';
      },
      { signal }
    );

    bindPointerTap(
      cornerMenuBtn,
      () => {
        const mode = cornerMenuBtn?.dataset.cornerMode;
        if (mode === 'back' || mode === 'menu') {
          backStack.triggerMenuOrBack();
        }
      },
      {
        signal,
        stopPropagation: true,
      }
    );

    cornerMenuBtn?.addEventListener(
      'click',
      (ev: MouseEvent) => {
        ev.stopPropagation();
        if (cornerPressedInNavMode) {
          cornerPressedInNavMode = false;
          return;
        }
        const mode = cornerMenuBtn.dataset.cornerMode;
        if (mode !== 'login' && mode !== 'logout') {
          return;
        }
        const sync = manager.getSyncStatus();
        if (!sync.isFirebaseConfigured) {
          setStatus('Google Sign-In is not configured in this environment.');
          return;
        }
        setStatus('');
        if (sync.user) {
          audioManager.playSfx('cancel');
          void manager.signOutFromGoogle();
        } else {
          audioManager.playSfx('select');
          void manager.signInWithGoogleAndSync().catch((err: unknown) => {
            const msg = err instanceof Error ? err.message : '';
            if (msg && !msg.toLowerCase().includes('popup-closed-by-user')) {
              setStatus(`Could not complete sign-in: ${msg}`);
            }
          });
        }
      },
      { signal }
    );

    bindPointerTap(devToolsBtn, () => toggleDevTools(), {
      signal,
      stopPropagation: true,
    });

    // PC Right-Click parity + Mobile Long-Press parity on viewport background
    bindBackGestureSurface(viewportEl, () => backStack.triggerMenuOrBack(), { signal });

    // Single Direct Title CTA:
    // - `Continue` -> jumps straight into active Overworld save
    // - `Start`    -> jumps straight into 5-Dungeon Demo Quiz / NG+ Picker
    bindPointerTap(
      btnContinue,
      () => {
        audioManager.playSfx('select');
        setStatus('');
        if (manager.getSave() !== null) {
          void openOverworldScene({ preservePosition: true });
        } else {
          openDemoQuizFlow();
        }
      },
      { signal }
    );

    manager.subscribe(() => renderAll());
  }

  initMysteryEmblemApp();
  document.addEventListener('astro:after-swap', initMysteryEmblemApp);
</script>

