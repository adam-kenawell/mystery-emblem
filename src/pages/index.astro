---
import '@fontsource/fusion-pixel-12px-proportional-kr';
import '../mystery-emblem/ui/pmdWindow.css';

const title = 'Mystery Emblem — Tactical RPG';
const description =
  'A browser-based tactical RPG combining Fire Emblem Awakening gameplay systems with Pokémon Mystery Dungeon: Explorers of Sky visuals.';
const canonicalUrl = Astro.url.href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <title>{title}</title>
  </head>
  <body>
    <main class="mystery-emblem-shell">
      <div id="mystery-emblem-root" class="pmd-viewport">
        <!-- Admin-Only Dev Tools Button (Top-Left, strictly visible ONLY for ADMIN_DEVTOOLS_EMAILS) -->
        <button
          id="pmd-dev-tools-btn"
          class="pmd-window pmd-corner-btn pmd-corner-left"
          type="button"
          hidden
        >
          Dev Tools
        </button>

        <!-- Persistent Top-Right Corner Button: Google Log In / Log Out on Gate & Title; Menu / Back in Scenes -->
        <button
          id="pmd-corner-menu-btn"
          class="pmd-window pmd-corner-btn pmd-corner-right"
          type="button"
          data-corner-mode="login"
          aria-label="Log in with Google"
        >
          <svg
            class="pmd-google-g-icon"
            data-testid="google-g-icon"
            viewBox="0 0 24 24"
            width="16"
            height="16"
            aria-hidden="true"
          >
            <path
              fill="#4285F4"
              d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
            ></path>
            <path
              fill="#34A853"
              d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
            ></path>
            <path
              fill="#FBBC05"
              d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"
            ></path>
            <path
              fill="#EA4335"
              d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
            ></path>
          </svg>
          <span>Log In</span>
        </button>

        <!-- In-Development Gate Screen (Visible by default when logged out or not on ALLOWED_PREVIEW_EMAILS) -->
        <section
          id="pmd-under-dev-screen"
          class="pmd-window pmd-title-card"
          data-testid="under-dev-screen"
        >
          <span class="pmd-dev-badge">IN DEVELOPMENT</span>
          <h1 class="pmd-title">MYSTERY EMBLEM</h1>
          <p id="pmd-under-dev-message" class="pmd-desc">
            This website is currently in active development. Sign in with an authorized Google account at the top right for preview access.
          </p>
          <p id="pmd-under-dev-status" class="pmd-status" aria-live="polite" hidden></p>
        </section>

        <!-- Authentic PMD: Explorers of Sky Title Window (Shown only to authorized preview accounts) -->
        <section id="pmd-title-screen" class="pmd-window pmd-title-card" hidden>
          <h1 class="pmd-title">MYSTERY EMBLEM</h1>
          <p class="pmd-subtitle">Echoes of the Dragon Lineage</p>

          <p id="pmd-save-summary" class="pmd-desc">
            Command your Pokémon squad across five kingdoms in a tactical RPG adventure.
          </p>

          <div class="pmd-actions">
            <button
              class="pmd-btn pmd-btn-primary pmd-continue-btn"
              id="btn-continue"
              type="button"
            >
              <span id="btn-continue-label">Start</span>
              <span
                id="btn-continue-chapter"
                class="pmd-continue-chapter"
                data-testid="continue-chapter-badge"
                hidden
              ></span>
            </button>
          </div>

          <p id="pmd-status-msg" class="pmd-status" aria-live="polite" hidden></p>
        </section>

        <!-- Simplified Campaign Menu: Drenched Bluff Test Dungeon + Future Demo -->
        <section id="pmd-campaign-menu" class="pmd-window pmd-campaign-card" hidden>
          <header class="pmd-panel-header">
            <h2 class="pmd-panel-title">CAMPAIGN MENU</h2>
            <p class="pmd-panel-sub">Choose a mode to begin.</p>
          </header>

          <div class="pmd-campaign-options" role="group" aria-label="Campaign Menu Options">
            <button
              type="button"
              id="btn-enter-dungeon"
              class="pmd-btn pmd-btn-primary pmd-campaign-option-btn"
              data-testid="btn-enter-dungeon"
            >
              <span class="pmd-campaign-option-title">Drenched Bluff</span>
              <span class="pmd-campaign-option-sub">Single Test Dungeon</span>
            </button>

            <button
              type="button"
              id="btn-campaign-demo"
              class="pmd-btn pmd-campaign-option-btn"
              data-testid="btn-campaign-demo"
            >
              <span class="pmd-campaign-option-title">Demo</span>
              <span class="pmd-campaign-option-sub">Coming Soon</span>
            </button>
          </div>

          <p id="pmd-campaign-status" class="pmd-status" aria-live="polite" hidden></p>
        </section>

        <!-- Admin-Only Dev Tools Modal (Accessible ONLY when signed in as ADMIN_DEVTOOLS_EMAILS) -->
        <section id="pmd-devtools-modal" class="pmd-window pmd-panel" hidden>
          <header class="pmd-panel-header">
            <h2 class="pmd-panel-title">DEV TOOLS</h2>
            <p class="pmd-panel-sub">
              Admin diagnostics: balance registries, Cloud Sync, PMD sprites &amp; evolution stages, and portrait dialogue.
            </p>
          </header>

          <nav class="pmd-tabs" aria-label="Dev Tools Sub-Tabs">
            <button
              type="button"
              class="pmd-btn pmd-tab-btn is-active"
              data-devtab-btn="audit"
              data-testid="devtools-tab-audit"
            >
              Registry &amp; Sync
            </button>
            <button
              type="button"
              class="pmd-btn pmd-tab-btn"
              data-devtab-btn="sprites"
              data-testid="devtools-tab-sprites"
            >
              Sprites &amp; Stages
            </button>
            <button
              type="button"
              class="pmd-btn pmd-tab-btn"
              data-devtab-btn="dialogue"
              data-testid="devtools-tab-dialogue"
            >
              Dialogue &amp; Audio
            </button>
            <button
              type="button"
              class="pmd-btn pmd-tab-btn"
              data-devtab-btn="skirmish"
              data-testid="devtools-tab-skirmish"
            >
              Test Dungeon
            </button>
          </nav>

          <!-- DEV TAB 1: REGISTRY & CLOUD SYNC (Step 1) -->
          <div class="pmd-tab-panel" data-devtab-panel="audit">
            <div class="pmd-subcard">
              <h3 class="pmd-subcard-title">Save &amp; Cloud Sync Diagnostics</h3>
              <p id="devtools-sync-diagnostics" class="pmd-subcard-text">—</p>
              <div class="pmd-inline-btns">
                <button
                  type="button"
                  id="devtools-seed-save"
                  class="pmd-btn"
                  data-testid="devtools-seed-save"
                >
                  Seed Test Save (Prologue)
                </button>
                <button
                  type="button"
                  id="devtools-delete-account-save"
                  class="pmd-btn pmd-btn-danger"
                  data-testid="devtools-delete-account-save"
                >
                  Delete Save Data from Linked Account
                </button>
              </div>
              <p id="devtools-save-action-status" class="pmd-subcard-text" hidden></p>
            </div>

            <div id="registry-audit-banner" class="pmd-audit-banner"></div>
            <div id="registry-metrics-grid" class="pmd-metrics-grid"></div>
            <div id="registry-errors-box" class="pmd-errors-box" hidden></div>
          </div>

          <!-- DEV TAB 2: PMD SPRITES, EMOTION PORTRAITS & EVOLUTION STAGES (Step 2) -->
          <div class="pmd-tab-panel" data-devtab-panel="sprites" hidden>
            <div class="pmd-subcard">
              <h3 class="pmd-subcard-title">Species &amp; Evolutionary Stage Selector</h3>
              <div id="devtools-line-presets" class="pmd-inline-btns"></div>
              <select
                id="devtools-species-select"
                class="pmd-select"
                aria-label="Inspect Pokémon Species"
              ></select>
              <div id="devtools-stage-buttons" class="pmd-inline-btns"></div>
            </div>

            <div class="pmd-devtools-sprite-layout">
              <div class="pmd-subcard pmd-devtools-sprite-card">
                <h3 class="pmd-subcard-title">8-Directional Map Sprite</h3>
                <div id="devtools-sprite-stage" class="pmd-devtools-sprite-stage"></div>
                <p id="devtools-sprite-meta" class="pmd-subcard-text">—</p>
              </div>

              <div class="pmd-subcard">
                <h3 class="pmd-subcard-title">Actions (5) &amp; Directions (8)</h3>
                <div id="devtools-action-buttons" class="pmd-inline-btns"></div>
                <div id="devtools-direction-buttons" class="pmd-inline-btns"></div>
              </div>
            </div>

            <div class="pmd-subcard">
              <div class="pmd-devtools-row-between">
                <h3 class="pmd-subcard-title">8-Emotion Character Portraits</h3>
                <button
                  type="button"
                  id="devtools-portrait-mirror-btn"
                  class="pmd-btn pmd-chip-btn"
                  data-testid="devtools-portrait-mirror-btn"
                >
                  Facing: Left Slot (Default)
                </button>
              </div>
              <div id="devtools-portrait-grid" class="pmd-devtools-portrait-grid"></div>
            </div>

            <div class="pmd-subcard">
              <h3 class="pmd-subcard-title">Active Party Live Evolution Stage Swapper</h3>
              <div id="devtools-roster-evo-box" class="pmd-devtools-roster-list"></div>
            </div>
          </div>

          <!-- DEV TAB 3: PORTRAIT DIALOGUE OVERLAY & AUDIO JUKEBOX HARNESS -->
          <div class="pmd-tab-panel" data-devtab-panel="dialogue" hidden>
            <div class="pmd-subcard">
              <h3 class="pmd-subcard-title">Portrait Dialogue Engine (`DIALOGUE_OVERLAY`)</h3>
              <p id="devtools-dialogue-cast" class="pmd-subcard-text">—</p>
              <p class="pmd-subcard-text">
                Sample cutscene cues: <em>#004 On the Beach at Dusk</em> → <em>#016 Growing Anxiety</em> → <em>#017 Oh No!</em> → <em>#019 Boss Battle!</em> → <em>#020 Time Gear Remix</em>.
              </p>
              <div class="pmd-inline-btns">
                <button
                  type="button"
                  id="devtools-launch-dialogue"
                  class="pmd-btn pmd-btn-primary"
                  data-testid="devtools-launch-dialogue"
                >
                  Play Prologue Awakening Cutscene
                </button>
                <button
                  type="button"
                  id="devtools-cycle-lord-stage"
                  class="pmd-btn"
                  data-testid="devtools-cycle-lord-stage"
                >
                  Cycle Active Lord Stage
                </button>
                <button
                  type="button"
                  id="devtools-instant-dialogue-toggle"
                  class="pmd-btn"
                  data-testid="devtools-instant-dialogue-toggle"
                >
                  Text Reveal: Typewriter
                </button>
              </div>
              <p id="devtools-dialogue-status" class="pmd-subcard-text">Ready.</p>
            </div>

            <div class="pmd-subcard">
              <div class="pmd-devtools-row-between">
                <h3 class="pmd-subcard-title">Explorers of Sky Audio Engine &amp; BGM Jukebox</h3>
                <button
                  type="button"
                  id="devtools-audio-mute"
                  class="pmd-btn pmd-chip-btn"
                  data-testid="devtools-audio-mute"
                >
                  Mute Audio
                </button>
              </div>
              <p
                id="devtools-audio-status"
                class="pmd-subcard-text"
                data-testid="devtools-audio-status"
              >
                —
              </p>
              <select
                id="devtools-bgm-select"
                class="pmd-select"
                data-testid="devtools-bgm-select"
                aria-label="Select Explorers of Sky BGM Track"
              ></select>
              <div class="pmd-inline-btns">
                <button
                  type="button"
                  id="devtools-bgm-play"
                  class="pmd-btn pmd-btn-primary"
                  data-testid="devtools-bgm-play"
                >
                  Play Selected Track
                </button>
                <button
                  type="button"
                  id="devtools-bgm-stop"
                  class="pmd-btn"
                  data-testid="devtools-bgm-stop"
                >
                  Stop BGM
                </button>
                <button type="button" id="devtools-sfx-select" class="pmd-btn pmd-chip-btn">
                  SFX: Confirm
                </button>
                <button type="button" id="devtools-sfx-cancel" class="pmd-btn pmd-chip-btn">
                  SFX: Cancel
                </button>
                <button type="button" id="devtools-sfx-advance" class="pmd-btn pmd-chip-btn">
                  SFX: Advance
                </button>
              </div>
              <div class="pmd-sync-grid">
                <label class="pmd-slider-row" for="devtools-bgm-volume">
                  <span>BGM Vol</span>
                  <input
                    id="devtools-bgm-volume"
                    class="pmd-range"
                    type="range"
                    min="0"
                    max="100"
                    value="65"
                  />
                </label>
                <label class="pmd-slider-row" for="devtools-sfx-volume">
                  <span>SFX Vol</span>
                  <input
                    id="devtools-sfx-volume"
                    class="pmd-range"
                    type="range"
                    min="0"
                    max="100"
                    value="70"
                  />
                </label>
              </div>
            </div>
          </div>

          <!-- DEV TAB 4: TEST DUNGEON / SKIRMISH BATTLEFIELD SANDBOX (Step 5) -->
          <div class="pmd-tab-panel" data-devtab-panel="skirmish" hidden>
            <div class="pmd-subcard">
              <h3 class="pmd-subcard-title">Playable Dungeon Battle — Drenched Bluff</h3>
              <p class="pmd-subcard-text">
                Full Turn-Based Player &amp; Enemy Phase dungeon battle flow with <strong>DUNGEON PREP</strong> (Manage Units, Manage Items, View Map &amp; Enter Dungeon), Fire Emblem <strong>Combat Forecast</strong>, 8-directional attack/hurt animations, active pursue-and-attack Enemy AI, <strong>VICTORY!</strong>, and Dragon Lord <strong>DEFEAT / Restart Match</strong>.
              </p>
              <div class="pmd-inline-btns">
                <button
                  type="button"
                  id="devtools-launch-battle"
                  class="pmd-btn pmd-btn-primary"
                  data-testid="devtools-launch-battle"
                >
                  Play Dungeon Battle
                </button>
              </div>
            </div>
            <div class="pmd-subcard">
              <h3 class="pmd-subcard-title">Test Dungeon (Skirmish) — Convergence Ruins</h3>
              <p class="pmd-subcard-text">
                Full-viewport tactical grid rendered from flat <em>Explorers of Sky</em> 24×24px tilesets at crisp 2× pixel scale across all 10 PMD terrain types (<em>Floor</em>, <em>Trees</em>, <em>Stairs</em>, <em>Water</em>, <em>Lava</em>, <em>Mountain</em>, <em>Void / Chasm</em>, <em>Wonder Tile</em>, <em>Low Barrier</em>, and <em>Wall</em>).
              </p>
              <p class="pmd-subcard-text">
                Spawns 3 test Pokémon covering all 3 traversal classes — <strong>Bahamut</strong> (Dratini · Grounded), <strong>Zephyr</strong> (Pidgey · Flying), and <strong>Wisp</strong> (Duskull · Levitate) — plus 2 stationary dummy enemies for Danger Area testing, species/Heavy-Duty Boots sandbox controls, and a live 144-sheet 24×24 chunk brush with JSON export.
              </p>
              <div class="pmd-inline-btns">
                <button
                  type="button"
                  id="devtools-launch-test-dungeon"
                  class="pmd-btn pmd-btn-primary"
                  data-testid="devtools-launch-test-dungeon"
                >
                  Launch Test Dungeon (Skirmish)
                </button>
              </div>
            </div>
          </div>
        </section>

        <!-- Reusable PMD Nickname Modal (Pointer-driven, PC + Mobile) -->
        <div id="pmd-nickname-backdrop" class="pmd-modal-backdrop" hidden>
          <div
            class="pmd-window pmd-nickname-dialog"
            role="dialog"
            aria-modal="true"
            aria-labelledby="nickname-modal-title"
          >
            <h3 id="nickname-modal-title" class="pmd-panel-title">Give a Nickname</h3>
            <p id="nickname-modal-species" class="pmd-panel-sub"></p>

            <input
              id="nickname-input"
              type="text"
              maxlength="16"
              class="pmd-text-input"
              placeholder="Enter nickname (up to 16 characters)"
              autocomplete="off"
            />

            <div class="pmd-preset-row">
              <span class="pmd-preset-label">Suggestions:</span>
              <button type="button" class="pmd-btn pmd-chip-btn" data-preset="Bahamut">Bahamut</button>
              <button type="button" class="pmd-btn pmd-chip-btn" data-preset="Sprout">Sprout</button>
              <button type="button" class="pmd-btn pmd-chip-btn" data-preset="Clover">Clover</button>
            </div>

            <div class="pmd-inline-btns pmd-modal-actions">
              <button type="button" id="btn-save-nickname" class="pmd-btn pmd-btn-primary">
                Confirm
              </button>
              <button type="button" id="btn-reset-nickname" class="pmd-btn">
                Default Name
              </button>
              <button type="button" id="btn-cancel-nickname" class="pmd-btn">
                Cancel
              </button>
            </div>
          </div>
        </div>
      </div>
    </main>
  </body>
</html>

<script>
  import { resetSpriteWidgets } from '../utils/sprite-utils';
  import {
    PMD_PORTRAIT_EMOTIONS,
    PMD_SPRITE_ACTIONS,
    clearPmdAssetCache,
    loadSpeciesPortrait,
    loadSpeciesSpriteBundle,
  } from '../mystery-emblem/assets/pmdAssetLoader';
  import {
    PMD_TILESET_LIST,
    clearTilesetCache,
    loadTilesetSheet,
  } from '../mystery-emblem/assets/tilesetLoader';
  import { getAudioManager } from '../mystery-emblem/audio/AudioManager';
  import {
    ADMIN_DEVTOOLS_EMAILS,
    ALLOWED_PREVIEW_EMAILS,
    DEV_PREVIEW_GATE_ENABLED,
    hasAdminDevToolsAccess,
    hasPreviewSiteAccess,
  } from '../mystery-emblem/data/accessControl';
  import {
    getRegistryValidationSummary,
    getSpeciesById,
  } from '../mystery-emblem/data/index';
  import {
    computeEnemyDangerArea,
    computeUnitMovementAndAttackRange,
    findShortestPathAStar,
    getTerrainBonuses,
    getTerrainMoveCost,
  } from '../mystery-emblem/engine/terrainAndPathfinding';
  import {
    computeCombatForecast,
    computeHealForecast,
    getTypeEffectiveness,
    resolveCombatExchange,
  } from '../mystery-emblem/engine/combatEngine';
  import { chooseEnemyAction } from '../mystery-emblem/engine/enemyAi';
  import { BattleScene } from '../mystery-emblem/scenes/BattleScene';
  import { TestDungeonScene } from '../mystery-emblem/scenes/TestDungeonScene';
  import {
    InMemoryCloudSyncAdapter,
    type CloudSyncAdapter,
  } from '../mystery-emblem/state/firebaseSync';
  import {
    SaveStateManager,
    formatCampaignChapterLabel,
    getUnitEquippedItemId,
  } from '../mystery-emblem/state/SaveStateManager';
  import { DevToolsHarness } from '../mystery-emblem/ui/DevToolsHarness';
  import { DialogueOverlay } from '../mystery-emblem/ui/DialogueOverlay';
  import { destroyAllPmdSpriteActors } from '../mystery-emblem/ui/PmdSpriteCanvas';
  import {
    BackStackController,
    bindBackGestureSurface,
    bindPointerTap,
  } from '../mystery-emblem/ui/pointerControls';

  const GOOGLE_G_SVG_MARKUP = `<svg class="pmd-google-g-icon" data-testid="google-g-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"></path><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"></path><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"></path><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"></path></svg>`;

  let currentManager: SaveStateManager | null = null;
  let currentDialogueOverlay: DialogueOverlay | null = null;
  let currentDevToolsHarness: DevToolsHarness | null = null;
  let currentBattleScene: BattleScene | null = null;
  let currentTestDungeonScene: TestDungeonScene | null = null;
  let uiAbortController: AbortController | null = null;

  async function initMysteryEmblemApp() {
    resetSpriteWidgets();
    destroyAllPmdSpriteActors();
    currentBattleScene?.destroy();
    currentBattleScene = null;
    currentTestDungeonScene?.destroy();
    currentTestDungeonScene = null;
    currentDevToolsHarness?.destroy();
    currentDevToolsHarness = null;
    currentDialogueOverlay?.destroy();
    currentDialogueOverlay = null;
    currentManager?.dispose();
    uiAbortController?.abort();
    uiAbortController = new AbortController();
    const signal = uiAbortController.signal;

    const injectedAdapter = (window as unknown as Record<string, unknown>)
      .__MYSTERY_EMBLEM_TEST_CLOUD_ADAPTER__ as CloudSyncAdapter | undefined;

    const manager = new SaveStateManager(undefined, injectedAdapter);
    currentManager = manager;
    const audioManager = getAudioManager();

    const validation = getRegistryValidationSummary();

    const viewportEl = document.getElementById('mystery-emblem-root');
    const underDevScreen = document.getElementById('pmd-under-dev-screen');
    const underDevMessageEl = document.getElementById('pmd-under-dev-message');
    const underDevStatusEl = document.getElementById('pmd-under-dev-status');
    const titleScreen = document.getElementById('pmd-title-screen');
    const campaignMenu = document.getElementById('pmd-campaign-menu');
    const devToolsModal = document.getElementById('pmd-devtools-modal');
    const devToolsBtn = document.getElementById('pmd-dev-tools-btn');
    const cornerMenuBtn = document.getElementById('pmd-corner-menu-btn') as HTMLButtonElement | null;
    const statusMsgEl = document.getElementById('pmd-status-msg');
    const campaignStatusEl = document.getElementById('pmd-campaign-status');

    const btnContinue = document.getElementById('btn-continue') as HTMLButtonElement | null;
    const btnContinueLabel = document.getElementById('btn-continue-label');
    const btnContinueChapter = document.getElementById('btn-continue-chapter');

    const btnEnterDungeon = document.getElementById('btn-enter-dungeon');
    const btnCampaignDemo = document.getElementById('btn-campaign-demo');

    const devToolsSyncDiagnostics = document.getElementById('devtools-sync-diagnostics');
    const auditBanner = document.getElementById('registry-audit-banner');
    const metricsGrid = document.getElementById('registry-metrics-grid');
    const errorsBox = document.getElementById('registry-errors-box');

    const nicknameBackdrop = document.getElementById('pmd-nickname-backdrop');
    const nicknameSpeciesEl = document.getElementById('nickname-modal-species');
    const nicknameInput = document.getElementById('nickname-input') as HTMLInputElement | null;
    const btnSaveNickname = document.getElementById('btn-save-nickname');
    const btnResetNickname = document.getElementById('btn-reset-nickname');
    const btnCancelNickname = document.getElementById('btn-cancel-nickname');

    let editingUnitId: string | null = null;
    let battleScene: BattleScene | null = null;
    let battleReturnTarget: 'campaign' | 'devtools' | 'title' = 'campaign';
    let testDungeonScene: TestDungeonScene | null = null;

    function getExtraPreviewEmails(): ReadonlyArray<string> | undefined {
      const injected = (window as unknown as Record<string, unknown>)
        .__MYSTERY_EMBLEM_TEST_EXTRA_PREVIEW_EMAILS__;
      return Array.isArray(injected) ? (injected as string[]) : undefined;
    }

    function isPreviewAuthorized(): boolean {
      const email = manager.getSyncStatus().user?.email;
      return hasPreviewSiteAccess(email, getExtraPreviewEmails());
    }

    function isAdminSignedIn(): boolean {
      const email = manager.getSyncStatus().user?.email;
      return hasAdminDevToolsAccess(email);
    }

    const backStack = new BackStackController(
      cornerMenuBtn,
      () => {
        if (!isPreviewAuthorized()) return;
        if (battleScene?.isOpen()) {
          battleScene.handleMenuOrBack();
          return;
        }
        if (testDungeonScene?.isOpen()) {
          testDungeonScene.handleMenuOrBack();
          return;
        }
      },
      {
        syncIdleButton: (btn) => {
          if (isPreviewAuthorized() && (battleScene?.isOpen() || testDungeonScene?.isOpen())) {
            btn.textContent = 'Menu';
            btn.dataset.cornerMode = 'menu';
            btn.setAttribute('aria-label', 'Open System Menu');
            btn.removeAttribute('title');
            return;
          }

          const sync = manager.getSyncStatus();
          if (sync.user) {
            const who = sync.user.email ?? sync.user.displayName ?? 'Google Account';
            btn.innerHTML = `${GOOGLE_G_SVG_MARKUP}<span>Log Out</span>`;
            btn.dataset.cornerMode = 'logout';
            btn.setAttribute('aria-label', `Signed in as ${who} — Log out`);
            btn.setAttribute('title', `Signed in as ${who}`);
          } else {
            btn.innerHTML = `${GOOGLE_G_SVG_MARKUP}<span>Log In</span>`;
            btn.dataset.cornerMode = 'login';
            btn.setAttribute('aria-label', 'Log in with Google');
            btn.removeAttribute('title');
          }
        },
      }
    );

    const dialogueOverlay = viewportEl
      ? new DialogueOverlay(viewportEl, manager, {
          onStateChange: () => backStack.syncButtonLabel(),
          audioManager,
        })
      : null;
    currentDialogueOverlay = dialogueOverlay;

    async function openBattleScene(source: 'campaign' | 'devtools' = 'campaign'): Promise<void> {
      if (!battleScene || !isPreviewAuthorized()) return;
      if (source === 'devtools' && !isAdminSignedIn()) return;
      battleReturnTarget = source;
      if (underDevScreen) underDevScreen.hidden = true;
      if (titleScreen) titleScreen.hidden = true;
      if (campaignMenu) campaignMenu.hidden = true;
      if (devToolsModal) devToolsModal.hidden = true;
      await battleScene.open();
      backStack.syncButtonLabel();
    }

    async function openTestDungeon(): Promise<void> {
      if (!testDungeonScene || !isPreviewAuthorized() || !isAdminSignedIn()) return;
      if (underDevScreen) underDevScreen.hidden = true;
      if (titleScreen) titleScreen.hidden = true;
      if (campaignMenu) campaignMenu.hidden = true;
      if (devToolsModal) devToolsModal.hidden = true;
      await testDungeonScene.open();
      backStack.syncButtonLabel();
    }

    if (viewportEl) {
      battleScene = new BattleScene({
        viewportEl,
        saveManager: manager,
        audioManager,
        onExit: () => {
          if (!isPreviewAuthorized()) {
            showTitleScreen();
            return;
          }
          if (battleReturnTarget === 'devtools' && isAdminSignedIn() && devToolsModal) {
            if (underDevScreen) underDevScreen.hidden = true;
            if (titleScreen) titleScreen.hidden = true;
            if (campaignMenu) campaignMenu.hidden = true;
            devToolsModal.hidden = false;
            currentDevToolsHarness?.onSaveChanged();
            backStack.syncButtonLabel();
          } else if (battleReturnTarget === 'campaign') {
            openCampaignMenu();
          } else {
            showTitleScreen();
          }
        },
        onLayerStateChanged: () => backStack.syncButtonLabel(),
      });
      currentBattleScene = battleScene;

      testDungeonScene = new TestDungeonScene({
        viewportEl,
        audioManager,
        onExit: () => {
          if (isPreviewAuthorized() && isAdminSignedIn() && devToolsModal) {
            if (underDevScreen) underDevScreen.hidden = true;
            if (titleScreen) titleScreen.hidden = true;
            if (campaignMenu) campaignMenu.hidden = true;
            devToolsModal.hidden = false;
            currentDevToolsHarness?.onSaveChanged();
            backStack.syncButtonLabel();
          } else {
            showTitleScreen();
          }
        },
        onLayerStateChanged: () => backStack.syncButtonLabel(),
      });
      currentTestDungeonScene = testDungeonScene;
    }

    function openNicknameModal(instanceId: string): void {
      if (!isPreviewAuthorized()) return;
      const save = manager.getSave();
      const unit = save?.roster.find((u) => u.instanceId === instanceId);
      if (!unit || !nicknameBackdrop || !nicknameInput) return;
      const sp = getSpeciesById(unit.speciesId);
      editingUnitId = instanceId;
      if (nicknameSpeciesEl) {
        nicknameSpeciesEl.textContent = `${sp?.name ?? unit.speciesId} · Lv. ${unit.level}`;
      }
      nicknameInput.value = unit.nickname;
      nicknameBackdrop.hidden = false;
      backStack.syncButtonLabel();
    }

    function closeNicknameModal(): void {
      editingUnitId = null;
      if (nicknameBackdrop) nicknameBackdrop.hidden = true;
      backStack.syncButtonLabel();
    }

    if (devToolsModal && dialogueOverlay) {
      currentDevToolsHarness = new DevToolsHarness({
        modalEl: devToolsModal,
        saveManager: manager,
        dialogueOverlay,
        audioManager,
        onLaunchBattle: () => {
          void openBattleScene('devtools');
        },
        onLaunchTestDungeon: () => {
          void openTestDungeon();
        },
        onRequestRenameUnit: (instanceId) => {
          openNicknameModal(instanceId);
        },
        signal,
      });
    }

    (window as unknown as Record<string, unknown>).__MYSTERY_EMBLEM_DEBUG__ = {
      saveManager: manager,
      SaveStateManager,
      formatCampaignChapterLabel,
      getUnitEquippedItemId,
      DEV_PREVIEW_GATE_ENABLED,
      ALLOWED_PREVIEW_EMAILS,
      ADMIN_DEVTOOLS_EMAILS,
      hasPreviewSiteAccess,
      hasAdminDevToolsAccess,
      InMemoryCloudSyncAdapter,
      getRegistryValidationSummary,
      audioManager,
      dialogueOverlay,
      devToolsHarness: currentDevToolsHarness,
      battleScene,
      openBattleScene,
      testDungeonScene,
      openNicknameModal,
      computeCombatForecast,
      computeHealForecast,
      resolveCombatExchange,
      getTypeEffectiveness,
      chooseEnemyAction,
      openTestDungeon,
      loadSpeciesSpriteBundle,
      loadSpeciesPortrait,
      clearPmdAssetCache,
      PMD_SPRITE_ACTIONS,
      PMD_PORTRAIT_EMOTIONS,
      PMD_TILESET_LIST,
      loadTilesetSheet,
      clearTilesetCache,
      getTerrainMoveCost,
      getTerrainBonuses,
      computeUnitMovementAndAttackRange,
      findShortestPathAStar,
      computeEnemyDangerArea,
    };

    function setStatus(msg: string): void {
      const trimmed = msg.trim();
      const targetEl = isPreviewAuthorized() ? statusMsgEl : underDevStatusEl;
      const otherEl = isPreviewAuthorized() ? underDevStatusEl : statusMsgEl;
      if (otherEl) {
        otherEl.textContent = '';
        otherEl.hidden = true;
      }
      if (!targetEl) return;
      targetEl.textContent = trimmed;
      targetEl.hidden = trimmed.length === 0;
    }

    function setCampaignStatus(msg: string): void {
      if (!campaignStatusEl) return;
      const trimmed = msg.trim();
      campaignStatusEl.textContent = trimmed;
      campaignStatusEl.hidden = trimmed.length === 0;
    }

    function showTitleScreen(): void {
      if (campaignMenu) campaignMenu.hidden = true;
      if (devToolsModal) devToolsModal.hidden = true;
      if (isPreviewAuthorized()) {
        if (underDevScreen) underDevScreen.hidden = true;
        if (titleScreen) titleScreen.hidden = false;
      } else {
        if (titleScreen) titleScreen.hidden = true;
        if (underDevScreen) underDevScreen.hidden = false;
      }
      backStack.syncButtonLabel();
    }

    function openCampaignMenu(): void {
      if (!isPreviewAuthorized()) return;
      setCampaignStatus('');
      if (underDevScreen) underDevScreen.hidden = true;
      if (titleScreen) titleScreen.hidden = true;
      if (devToolsModal) devToolsModal.hidden = true;
      if (campaignMenu) campaignMenu.hidden = false;
      backStack.syncButtonLabel();
    }

    function toggleDevTools(): void {
      if (!isPreviewAuthorized() || !isAdminSignedIn() || !devToolsModal) return;
      if (battleScene?.isOpen()) {
        battleReturnTarget = 'devtools';
        battleScene.close();
        return;
      }
      if (testDungeonScene?.isOpen()) {
        testDungeonScene.close();
        return;
      }
      if (!devToolsModal.hidden) {
        showTitleScreen();
        return;
      }
      if (underDevScreen) underDevScreen.hidden = true;
      if (titleScreen) titleScreen.hidden = true;
      if (campaignMenu) campaignMenu.hidden = true;
      devToolsModal.hidden = false;
      currentDevToolsHarness?.onSaveChanged();
      backStack.syncButtonLabel();
    }

    // Register navigation layers from lowest to highest LIFO priority
    backStack.registerLayer({
      id: 'campaign-menu',
      isActive: () => Boolean(campaignMenu && !campaignMenu.hidden),
      onBack: () => showTitleScreen(),
    });
    backStack.registerLayer({
      id: 'devtools-modal',
      isActive: () => Boolean(devToolsModal && !devToolsModal.hidden),
      onBack: () => showTitleScreen(),
    });
    backStack.registerLayer({
      id: 'battle-scene-sublayer',
      isActive: () => Boolean(battleScene?.isOpen() && battleScene.hasActiveSubLayer()),
      onBack: () => battleScene?.handleMenuOrBack(),
    });
    backStack.registerLayer({
      id: 'test-dungeon-sublayer',
      isActive: () => Boolean(testDungeonScene?.isOpen() && testDungeonScene.hasActiveSubLayer()),
      onBack: () => testDungeonScene?.handleMenuOrBack(),
    });
    backStack.registerLayer({
      id: 'dialogue-overlay',
      isActive: () => Boolean(dialogueOverlay?.isOpen()),
      onBack: () => dialogueOverlay?.close('cancelled'),
    });
    backStack.registerLayer({
      id: 'nickname-modal',
      isActive: () => Boolean(nicknameBackdrop && !nicknameBackdrop.hidden),
      onBack: () => closeNicknameModal(),
    });

    function renderRegistryAudit(): void {
      if (!auditBanner || !metricsGrid) return;
      const c = validation.counts;
      auditBanner.className = validation.valid
        ? 'pmd-audit-banner is-valid'
        : 'pmd-audit-banner is-invalid';
      auditBanner.textContent = validation.valid
        ? `SCHEMA & FACTION AUDIT PASSED · 0 ERRORS · Sole Shared Line: ${c.sharedLines.join(', ')}`
        : `SCHEMA AUDIT FAILED · ${validation.errors.length} Error(s)`;

      const metrics: Array<[string, string]> = [
        ['Total Species Stages', String(c.totalSpecies)],
        ['Evolutionary Lines', String(c.totalLines)],
        ['Dragon Lords', `${c.dragonLordLines} lines`],
        ['Starter Partners', `${c.starterPartnerLines} lines`],
        ['Q1–Q9 Quiz Pool', `${c.quizRecruitLines} lines`],
        ['Story Chapter Recruits', `${c.storyRecruitLines} lines`],
        ['Paralogue Recruits', `${c.paralogueRecruitLines} lines`],
        ['Enemy Roster Lines', `${c.enemyLines} lines`],
        ['Moves (1R / 2R / Sup)', `${c.totalMoves} (${c.physicalMoves}/${c.specialMoves}/${c.supportHealMoves})`],
        ['Pure Stat Moves', `${c.pureStatChangeMoves} (Rule 4)`],
        ['Items & TMs', `${c.totalItems} (${c.tmCount} TMs)`],
        ['Personal Skills', String(c.totalPersonalSkills)],
      ];

      metricsGrid.innerHTML = '';
      for (const [label, value] of metrics) {
        const card = document.createElement('div');
        card.className = 'pmd-metric-card';
        card.innerHTML = `<span class="pmd-metric-label">${label}</span><strong class="pmd-metric-val">${value}</strong>`;
        metricsGrid.appendChild(card);
      }

      if (errorsBox) {
        if (validation.errors.length > 0) {
          errorsBox.hidden = false;
          errorsBox.textContent = validation.errors.join('\n');
        } else {
          errorsBox.hidden = true;
        }
      }
    }

    function renderAll(): void {
      const save = manager.getSave();
      const sync = manager.getSyncStatus();
      const previewAllowed = isPreviewAuthorized();
      const adminActive = previewAllowed && isAdminSignedIn();

      if (!previewAllowed) {
        if (devToolsBtn) devToolsBtn.hidden = true;
        if (battleScene?.isOpen()) battleScene.close();
        if (testDungeonScene?.isOpen()) testDungeonScene.close();
        if (dialogueOverlay?.isOpen()) dialogueOverlay.close('cancelled');
        if (nicknameBackdrop && !nicknameBackdrop.hidden) {
          editingUnitId = null;
          nicknameBackdrop.hidden = true;
        }
        if (devToolsModal) devToolsModal.hidden = true;
        if (campaignMenu) campaignMenu.hidden = true;
        if (titleScreen) titleScreen.hidden = true;
        if (underDevScreen) underDevScreen.hidden = false;

        if (underDevMessageEl) {
          if (sync.user) {
            const who = sync.user.email ?? sync.user.displayName ?? 'this Google account';
            underDevMessageEl.textContent = `This website is currently in active development. Signed in as ${who} — this account does not have preview access yet.`;
          } else {
            underDevMessageEl.textContent =
              'This website is currently in active development. Sign in with an authorized Google account at the top right for preview access.';
          }
        }

        if (audioManager.getCurrentTrackId()) {
          audioManager.stopBgm({ fadeMs: 200 });
        }

        backStack.syncButtonLabel();
        return;
      }

      // Authorized preview account: hide In-Development gate and arm Top Menu BGM (`002`)
      if (underDevScreen) underDevScreen.hidden = true;
      if (underDevStatusEl) {
        underDevStatusEl.textContent = '';
        underDevStatusEl.hidden = true;
      }
      if (!audioManager.getCurrentTrackId()) {
        audioManager.playBgm('top_menu', { fadeMs: 350 });
      }

      // Reveal Title Screen if no other authorized scene/panel is currently open
      const anyPanelOrSceneOpen =
        Boolean(campaignMenu && !campaignMenu.hidden) ||
        Boolean(devToolsModal && !devToolsModal.hidden) ||
        Boolean(battleScene?.isOpen()) ||
        Boolean(testDungeonScene?.isOpen());
      if (!anyPanelOrSceneOpen && titleScreen) {
        titleScreen.hidden = false;
      }

      // Strictly gate Top-Left Dev Tools button, modal & Test Dungeon to ADMIN_DEVTOOLS_EMAILS
      if (devToolsBtn) {
        devToolsBtn.hidden = !adminActive;
      }
      if (!adminActive && testDungeonScene?.isOpen()) {
        testDungeonScene.close();
      }
      if (!adminActive && devToolsModal && !devToolsModal.hidden) {
        showTitleScreen();
      }

      if (save) {
        const chapterLabel = formatCampaignChapterLabel(save.campaign.currentChapterId);
        if (btnContinueLabel) {
          btnContinueLabel.textContent = 'Continue';
        }
        if (btnContinueChapter) {
          btnContinueChapter.textContent = chapterLabel;
          btnContinueChapter.hidden = false;
        }
      } else {
        if (btnContinueLabel) {
          btnContinueLabel.textContent = 'Start';
        }
        if (btnContinueChapter) {
          btnContinueChapter.textContent = '';
          btnContinueChapter.hidden = true;
        }
      }

      if (devToolsSyncDiagnostics) {
        const iso = save ? new Date(save.lastUpdated).toISOString() : 'none';
        const uidPath = sync.user ? `saves/${sync.user.uid}` : 'unauthenticated';
        const chapterInfo = save
          ? `${formatCampaignChapterLabel(save.campaign.currentChapterId)} (${save.campaign.currentChapterId})`
          : 'none';
        devToolsSyncDiagnostics.textContent = [
          `Save ID: ${save?.saveId ?? 'none'}`,
          `Chapter: ${chapterInfo}`,
          `Schema: v${save?.schemaVersion ?? '—'}`,
          `lastUpdated: ${iso}${save ? ` (${save.lastUpdated})` : ''}`,
          `Firestore Doc: ${uidPath}`,
          `Last Resolution: ${sync.lastResolution ?? 'none'}`,
        ].join(' · ');
      }

      currentDevToolsHarness?.onSaveChanged();
      backStack.syncButtonLabel();
    }

    // Top-Right Corner Button:
    // - In `back` / `menu` mode (Campaign Menu, Dev Tools, Dialogue, Battle/Test Dungeon): unified pointer tap
    // - In `login` / `logout` mode (Gate & Title Screen): native `click` activation so iOS Safari & Android Chrome permit `signInWithPopup`
    let cornerPressedInNavMode = false;
    cornerMenuBtn?.addEventListener(
      'pointerdown',
      (ev: PointerEvent) => {
        if (ev.button !== 0 && ev.pointerType === 'mouse') return;
        ev.stopPropagation();
        const mode = cornerMenuBtn.dataset.cornerMode;
        cornerPressedInNavMode = mode === 'back' || mode === 'menu';
      },
      { signal }
    );

    bindPointerTap(
      cornerMenuBtn,
      () => {
        const mode = cornerMenuBtn?.dataset.cornerMode;
        if (mode === 'back' || mode === 'menu') {
          backStack.triggerMenuOrBack();
        }
      },
      {
        signal,
        stopPropagation: true,
      }
    );

    cornerMenuBtn?.addEventListener(
      'click',
      (ev: MouseEvent) => {
        ev.stopPropagation();
        if (cornerPressedInNavMode) {
          cornerPressedInNavMode = false;
          return;
        }
        const mode = cornerMenuBtn.dataset.cornerMode;
        if (mode !== 'login' && mode !== 'logout') {
          return;
        }
        const sync = manager.getSyncStatus();
        if (!sync.isFirebaseConfigured) {
          setStatus('Google Sign-In is not configured in this environment.');
          return;
        }
        setStatus('');
        if (sync.user) {
          audioManager.playSfx('cancel');
          void manager.signOutFromGoogle();
        } else {
          audioManager.playSfx('select');
          void manager.signInWithGoogleAndSync().catch((err: unknown) => {
            const msg = err instanceof Error ? err.message : '';
            if (msg && !msg.toLowerCase().includes('popup-closed-by-user')) {
              setStatus(`Could not complete sign-in: ${msg}`);
            }
          });
        }
      },
      { signal }
    );

    bindPointerTap(devToolsBtn, () => toggleDevTools(), {
      signal,
      stopPropagation: true,
    });

    // PC Right-Click parity + Mobile Long-Press parity on viewport background
    bindBackGestureSurface(viewportEl, () => backStack.triggerMenuOrBack(), { signal });

    bindPointerTap(
      btnContinue,
      () => {
        if (!isPreviewAuthorized()) return;
        audioManager.playSfx('select');
        setStatus('');
        openCampaignMenu();
      },
      { signal }
    );

    bindPointerTap(
      btnEnterDungeon,
      () => {
        if (!isPreviewAuthorized()) return;
        audioManager.playSfx('select');
        void openBattleScene('campaign');
      },
      { signal }
    );

    bindPointerTap(
      btnCampaignDemo,
      () => {
        if (!isPreviewAuthorized()) return;
        audioManager.playSfx('select');
        setCampaignStatus('Demo mode is coming soon!');
      },
      { signal }
    );

    // Nickname Modal Controls
    document.querySelectorAll<HTMLElement>('.pmd-chip-btn[data-preset]').forEach((chip) => {
      bindPointerTap(
        chip,
        () => {
          if (nicknameInput && chip.dataset.preset) {
            nicknameInput.value = chip.dataset.preset;
          }
        },
        { signal }
      );
    });

    bindPointerTap(
      btnSaveNickname,
      () => {
        if (!editingUnitId || !nicknameInput) return;
        manager.renamePokemon(editingUnitId, nicknameInput.value);
        closeNicknameModal();
      },
      { signal }
    );

    bindPointerTap(
      btnResetNickname,
      () => {
        if (!editingUnitId) return;
        manager.renamePokemon(editingUnitId, '');
        closeNicknameModal();
      },
      { signal }
    );

    bindPointerTap(btnCancelNickname, () => closeNicknameModal(), { signal });

    renderRegistryAudit();
    manager.subscribe(() => renderAll());
  }

  initMysteryEmblemApp();
  document.addEventListener('astro:after-swap', initMysteryEmblemApp);
</script>

<style>
  :global(*, *::before, *::after) {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  :global(html, body) {
    width: 100%;
    min-height: 100%;
    background-color: #080e1c;
    color: #f8f8f8;
    font-family: 'Fusion Pixel 12px Proportional KR', sans-serif;
    line-height: 1.6;
    overflow-x: hidden;
  }

  :global(button, input, select, textarea) {
    font-family: inherit;
  }

  .mystery-emblem-shell {
    width: 100%;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    background: #080e1c;
  }

  .pmd-viewport {
    position: relative;
    flex: 1;
    width: 100%;
    min-height: 100dvh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 4.5rem 1.25rem 2rem;
    background: radial-gradient(circle at center, #1a2d54 0%, #0a1020 68%, #060a14 100%);
    user-select: none;
    touch-action: manipulation;
  }

  .pmd-corner-btn {
    position: fixed;
    top: max(0.85rem, env(safe-area-inset-top));
    min-height: 46px;
    min-width: 108px;
    padding: 0.45rem 0.95rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.48rem;
    font-size: 0.8rem;
    color: #f8d048;
    cursor: pointer;
    z-index: 95;
    transition: transform 0.15s, background-color 0.15s;
  }

  :global(.pmd-google-g-icon) {
    flex-shrink: 0;
    display: block;
    filter: drop-shadow(1px 1px 0 #081020);
  }

  .pmd-corner-left {
    left: max(0.85rem, env(safe-area-inset-left));
    color: #90d8f8;
  }

  .pmd-corner-right {
    right: max(0.85rem, env(safe-area-inset-right));
  }

  .pmd-corner-btn:hover,
  .pmd-corner-btn:active {
    background: rgba(32, 52, 88, 0.96);
    transform: translateY(-1px);
  }

  .pmd-title-card {
    max-width: 540px;
    width: 100%;
    padding: 2.35rem 1.85rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .pmd-dev-badge {
    display: inline-block;
    padding: 0.18rem 0.65rem;
    border-radius: 4px;
    border: 1px solid rgba(248, 208, 72, 0.72);
    background: rgba(248, 208, 72, 0.14);
    color: #f8d048;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
  }

  .pmd-campaign-card {
    max-width: 520px;
    width: 100%;
    padding: 1.85rem 1.6rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.1rem;
  }

  .pmd-campaign-options {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .pmd-campaign-option-btn {
    width: 100%;
    min-height: 62px;
    padding: 0.7rem 1.1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.2rem;
  }

  .pmd-campaign-option-title {
    font-size: 0.96rem;
    font-weight: bold;
    letter-spacing: 0.04em;
  }

  .pmd-campaign-option-sub {
    font-size: 0.72rem;
    color: #90d8f8;
  }

  .pmd-continue-btn {
    display: inline-flex;
    align-items: center;
