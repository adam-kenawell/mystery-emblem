---
import '@fontsource/fusion-pixel-12px-proportional-kr';
import '../mystery-emblem/ui/pmdWindow.css';

const title = 'Mystery Emblem — Tactical RPG';
const description =
  'A browser-based tactical RPG combining Fire Emblem Awakening gameplay systems with Pokémon Mystery Dungeon: Explorers of Sky visuals.';
const canonicalUrl = Astro.url.href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <link rel="icon" type="image/png" sizes="84x84" href={`${import.meta.env.BASE_URL}favicon.png`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}favicon.png`} />
    <title>{title}</title>
  </head>
  <body>
    <main class="mystery-emblem-shell">
      <div id="mystery-emblem-root" class="pmd-viewport">
        <!-- Full-Bleed Mystery Emblem Box Art Backdrop (Shown on Landing Title Screen) -->
        <div
          id="pmd-landing-backdrop"
          class="pmd-landing-backdrop"
          data-testid="landing-backdrop"
          aria-hidden="true"
        >
          <img
            class="pmd-landing-art"
            data-testid="landing-boxart"
            src={`${import.meta.env.BASE_URL}boxart.png`}
            alt=""
            decoding="async"
          />
        </div>

        <!-- Admin-Only Dev Tools Button (Top-Left, strictly visible ONLY for ADMIN_DEVTOOLS_EMAILS) -->
        <button
          id="pmd-dev-tools-btn"
          class="pmd-window pmd-window--compact pmd-corner-btn pmd-corner-left"
          type="button"
          hidden
        >
          Dev Tools
        </button>

        <!-- Persistent Top-Right Corner Button: Google Log In / Log Out on Title; Menu / Back in Scenes -->
        <button
          id="pmd-corner-menu-btn"
          class="pmd-window pmd-window--compact pmd-corner-btn pmd-corner-right"
          type="button"
          data-corner-mode="login"
          aria-label="Log in with Google"
        >
          <svg
            class="pmd-google-g-icon"
            data-testid="google-g-icon"
            viewBox="0 0 24 24"
            width="16"
            height="16"
            aria-hidden="true"
          >
            <path
              fill="#4285F4"
              d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
            ></path>
            <path
              fill="#34A853"
              d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
            ></path>
            <path
              fill="#FBBC05"
              d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"
            ></path>
            <path
              fill="#EA4335"
              d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
            ></path>
          </svg>
          <span>Log In</span>
        </button>

        <!-- Authentic PMD: Explorers of Sky Compact Start/Continue Window Over Box Art -->
        <section id="pmd-title-screen" class="pmd-window pmd-title-card">
          <h1 class="pmd-title pmd-sr-only">MYSTERY EMBLEM</h1>
          <div class="pmd-actions pmd-menu-list">
            <button
              class="pmd-btn pmd-btn-primary pmd-menu-row pmd-continue-btn"
              id="btn-continue"
              type="button"
            >
              <span id="btn-continue-label">Start</span>
              <span
                id="btn-continue-chapter"
                class="pmd-continue-chapter"
                data-testid="continue-chapter-badge"
                hidden
              ></span>
            </button>
          </div>
          <p id="pmd-status-msg" class="pmd-status" aria-live="polite" hidden></p>
        </section>

        <!-- Admin-Only Dev Tools Overlay Modal (Strictly accessible ONLY for ADMIN_DEVTOOLS_EMAILS) -->
        <div
          id="pmd-devtools-backdrop"
          class="pmd-devtools-backdrop"
          data-testid="devtools-backdrop"
          hidden
        >
          <section
            id="pmd-devtools-modal"
            class="pmd-window pmd-panel"
            role="dialog"
            aria-modal="true"
            aria-label="Admin Dev Tools"
          ></section>
        </div>
      </div>
    </main>
  </body>
</html>

<script>
  import { initMysteryEmblemApp } from '../mystery-emblem/app/bootstrapApp';

  void initMysteryEmblemApp();
  document.addEventListener('astro:after-swap', () => {
    void initMysteryEmblemApp();
  });
</script>
