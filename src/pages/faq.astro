---
import InfoPageLayout from '../layouts/InfoPageLayout.astro';
import { AUTHOR_BLOG_URL } from '../siteMeta';

const title = 'Mystery Emblem FAQ | Free Pokemon Fire Emblem Fan Game';
const description =
  'Answers about Mystery Emblem, the free Pokemon x Fire Emblem fan game: price, devices, saving, length, permadeath, and how to share feedback.';

const faqs: ReadonlyArray<{ q: string; a: string }> = [
  {
    q: 'What is Mystery Emblem?',
    a: 'A free fan game that mixes Fire Emblem-style tactics battles with the look of Pokemon Mystery Dungeon: Explorers of Sky. You lead a team of Pokemon across grid-based battlefields in a five-act story campaign.',
  },
  {
    q: 'Is it free?',
    a: 'Yes. Mystery Emblem is completely free, with no ads and no purchases.',
  },
  {
    q: 'Do I need to download anything?',
    a: 'No. It runs in your web browser on phones, tablets, and computers. Just open mysteryemblem.com and press Start.',
  },
  {
    q: 'How long is the current release?',
    a: 'Act 1: Expedition to Meet King Serperior takes under an hour and covers the Prologue, four story chapters, and Paralogue 1: Lush Prairie.',
  },
  {
    q: 'How do I save my progress?',
    a: 'The game saves automatically as you play. Sign in with Google on the title screen to sync your save across devices.',
  },
  {
    q: 'Is there permadeath like in Fire Emblem?',
    a: 'Only your Dragon hero (and any escorted green ally marked for protection) must survive a battle. Any other squad members who faint recover once the chapter ends.',
  },
  {
    q: 'Do I need to know Fire Emblem or Pokemon Mystery Dungeon?',
    a: "No. Quaquaval teaches every core mechanic step by step in the Prologue and records every lesson in Quaquaval's Field Notes so you can review them anytime. There is also a How to Play page on this site.",
  },
  {
    q: 'Which Pokemon can I play as?',
    a: 'A short personality quiz makes you one of five Dragon-type Pokemon: Axew, Bagon, Gible, Dratini, or Goomy. Quaxly, Flabebe, Quaquaval, Smoliv, Machop, Slakoth, Starly, Caterpie, Pawmi, Honedge, and Sandile join your roster across Act 1.',
  },
  {
    q: 'Is this an official Pokemon or Fire Emblem game?',
    a: 'No. Mystery Emblem is an unofficial, non-commercial fan game. It is not affiliated with or endorsed by Nintendo, The Pokemon Company, Game Freak, Creatures Inc., or Intelligent Systems.',
  },
  {
    q: 'How can I give feedback or follow development?',
    a: 'There is a short feedback link at the end of Act 1, and development updates are posted on the blog at adam.kenawell.family/blog.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};
---

<InfoPageLayout
  title={title}
  description={description}
  heading="Frequently Asked Questions"
  jsonLd={[faqJsonLd]}
>
  {
    faqs.map(({ q, a }) => (
      <section>
        <h2>{q}</h2>
        <p>{a}</p>
      </section>
    ))
  }
  <p>
    Still curious? Read <a href="/about/">about the game</a>, see <a href="/how-to-play/">how to play</a>,
    or follow along on the <a href={AUTHOR_BLOG_URL}>blog</a>.
  </p>
</InfoPageLayout>
