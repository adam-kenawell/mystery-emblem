    },
    {
      "id": "line_3",
      "say": {
        "speaker": "mentor",
        "emotion": "Happy",
        "side": "left",
        "text": "You’ve outgrown every lesson I taught you, {lord}, {partner}. The Heartland stands because of you all."
      },
      "actions": [{ "type": "pose", "who": "mentor", "anim": "Attack", "duration": 0.5 }]
    },
    {
      "id": "line_4",
      "say": {
        "speaker": "serperior",
        "emotion": "Normal",
        "side": "left",
        "text": "But Lairon spoke the truth. A coup has toppled Goldensand’s rulers, and the Abyss keeps growing."
      },
      "actions": [
        { "type": "walk", "who": "serperior", "path": [[8, 4]], "speed": 2.4, "facing": "Down" },
        { "type": "face", "who": "lord", "facing": "Up" },
