      "say": {
        "speaker": "partner",
        "emotion": "Joyous",
        "side": "right",
        "text": "Not bad for village kids who were sparring on the beach not long ago, huh, Dad?"
      },
      "actions": [
        { "type": "hop", "who": "partner", "count": 2 },
        { "type": "emote", "who": "partner", "emote": "joy", "duration": 1.15 }
