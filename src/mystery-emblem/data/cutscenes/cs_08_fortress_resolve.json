      "say": {
        "speaker": "milotic",
        "emotion": "Happy",
        "side": "right",
        "text": "When the desert road opens, {lord}, you won’t walk it alone. You’ll walk it with your family."
      },
      "actions": [{ "type": "walk", "who": "milotic", "path": [[9, 4]], "speed": 2.4, "facing": "Down" }]
    },
