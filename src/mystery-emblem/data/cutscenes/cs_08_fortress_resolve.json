    {
      "id": "line_2",
      "say": {
        "speaker": "advisor",
        "emotion": "Inspired",
        "side": "right",
        "text": "And I didn’t faint once the whole siege. I’d like that written down somewhere."
      },
      "actions": [
        { "type": "hop", "who": "advisor", "count": 2 },
        { "type": "emote", "who": "advisor", "emote": "music", "duration": 1.2 }
