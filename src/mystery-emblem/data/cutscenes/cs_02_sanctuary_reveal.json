{
  "id": "cs_02_sanctuary_reveal",
  "title": "Child of the Western Tide",
  "music": "thoughts_for_friends",
  "location": "bluff_camp",
  "banner": "Coastal Overlook · Evening Camp",
  "lighting": "campfire_dusk",
  "camera": { "x": 7.5, "y": 5.5 },
  "cast": [
    { "id": "mentor", "who": { "kind": "mentor" } },
    { "id": "lord", "who": { "kind": "lord" } },
    { "id": "partner", "who": { "kind": "partner" } },
    { "id": "healer", "who": { "kind": "healer" } },
    { "id": "advisor", "who": { "kind": "advisor" } }
  ],
  "placements": [
    { "id": "mentor", "x": 6, "y": 4, "facing": "DownRight" },
    { "id": "lord", "x": 8, "y": 5, "facing": "Left" },
    { "id": "partner", "x": 7, "y": 6, "facing": "Up" },
    { "id": "healer", "x": 6, "y": 5, "facing": "Right" },
    { "id": "advisor", "x": 8, "y": 4, "facing": "DownLeft" }
  ],
  "props": [{ "id": "coast_campfire", "kind": "campfire", "x": 7, "y": 5 }],
  "beats": [
    {
      "id": "opening",
      "actions": [
        { "type": "aura", "who": "lord", "duration": 1.1 },
        { "type": "emote", "who": "partner", "emote": "exclamation", "duration": 0.95, "delay": 0.25 }
      ],
      "advance": { "kind": "seconds", "seconds": 0.75 }
    },
    {
      "id": "line_1",
      "say": {
        "speaker": "partner",
        "emotion": "Surprised",
        "side": "right",
        "text": "Dad, did you see {lord} out there? When that Pawniard lunged, there was this golden glow!"
      },
      "actions": [
        { "type": "hop", "who": "partner", "count": 2 },
        { "type": "emote", "who": "partner", "emote": "joy", "duration": 1.1 }
      ]
    },
    {
      "id": "line_2",
      "say": {
        "speaker": "advisor",
        "emotion": "Stunned",
        "side": "right",
        "text": "I saw it. I’m still seeing it. Is that normal? That doesn’t seem normal."
      },
      "actions": [
        { "type": "shake", "who": "advisor", "duration": 0.5 },
        { "type": "emote", "who": "advisor", "emote": "sweat", "duration": 1.15 }
      ]
    },
    {
      "id": "line_3",
      "say": {
        "speaker": "mentor",
        "emotion": "Sad",
        "side": "left",
        "text": "It’s time you knew the truth. Years ago, Gengar betrayed the Dragon Kingdom and tore open the Abyss."
      },
      "actions": [{ "type": "walk", "who": "mentor", "path": [[7, 4]], "speed": 2.4, "facing": "Down" }]
    },
    {
      "id": "line_4",
      "say": {
        "speaker": "mentor",
        "emotion": "Normal",
        "side": "left",
        "text": "That same night, a baby Dragon washed up on this beach. I raised you as my own, {lord}."
      },
      "actions": [
        { "type": "aura", "who": "lord", "duration": 1.1 },
        { "type": "emote", "who": "lord", "emote": "question", "duration": 1.05 }
      ]
    },
    {
      "id": "line_5",
      "say": {
        "speaker": "lord",
        "emotion": "Worried",
        "side": "right",
        "text": "You knew all this time... Does it change anything? Between us, I mean."
      },
      "actions": [
        { "type": "face", "who": "partner", "toward": "lord" },
        { "type": "face", "who": "healer", "toward": "lord" }
      ]
    },
    {
      "id": "line_6",
      "say": {
        "speaker": "healer",
        "emotion": "Happy",
        "side": "left",
        "text": "Not a thing. You’re still the one who carried {advisor} across the crab pools."
      },
      "actions": [
        { "type": "emote", "who": "healer", "emote": "heart", "duration": 1.2 },
        { "type": "hop", "who": "partner", "count": 2, "delay": 0.24 }
      ]
    },
    {
      "id": "line_7",
      "say": {
        "speaker": "partner",
        "emotion": "Joyous",
        "side": "right",
        "text": "You’re family, {lord}. Anyone who wants you has to get through me. And Dad."
      },
      "actions": [{ "type": "emote", "who": "partner", "emote": "joy", "duration": 1.15 }]
    },
    {
      "id": "line_8",
      "say": {
        "speaker": "mentor",
        "emotion": "Determined",
        "side": "left",
        "text": "Rest now. At first light we take the Capital Road and warn the King."
      },
      "actions": [
        { "type": "pose", "who": "mentor", "anim": "Attack", "duration": 0.5 },
        { "type": "walk", "who": "lord", "path": [[9, 5]], "speed": 2.8, "facing": "Right" },
        { "type": "face", "who": "partner", "facing": "Right" }
      ]
    }
  ]
}
