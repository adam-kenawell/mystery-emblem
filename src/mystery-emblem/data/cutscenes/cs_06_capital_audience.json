      "id": "quaquaval_kneels",
      "say": {
        "speaker": "mentor",
        "emotion": "Determined",
        "side": "left",
        "text": "Your Majesty. Those feral beasts outside the capital walls were unlike any Pokemon in our natural world."
      }
    },
    {
      "id": "serperior_rift_news",
      "say": {
        "speaker": "serperior",
        "emotion": "Worried",
        "side": "right",
        "text": "They pour from tears in the sky that scholars call the Rift. Every week more of those savage creatures strike our border towns."
      }
    },
    {
      "id": "serperior_chronicles",
      "say": {
        "speaker": "serperior",
        "emotion": "Determined",
        "side": "right",
        "text": "Only charred fragments remain in our royal archives from the age before the six realms formed. They speak of a Dragon Kingdom shattered when the Rift first opened, yet the chronicles break off in smoke before recording how the dragons sealed the tear or what became of Hoopa."
      },
