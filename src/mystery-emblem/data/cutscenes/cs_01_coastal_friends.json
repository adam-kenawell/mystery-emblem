      "say": {
        "speaker": "lord",
        "emotion": "Surprised",
        "side": "left",
        "text": "Ironscale? Father, our village is right on the coast."
      },
      "actions": [{ "type": "walk", "who": "lord", "path": [[7, 5]], "speed": 2.8, "facing": "Right" }]
    },
    {
      "id": "line_7",
      "say": {
        "speaker": "mentor",
        "emotion": "Determined",
        "side": "right",
        "text": "Which is why the games end today. Come to the beach, all of you. I’ll teach you to fight."
