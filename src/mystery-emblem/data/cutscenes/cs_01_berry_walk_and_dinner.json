    {
      "id": "quaquaval_excuse",
      "say": {
        "speaker": "mentor",
        "emotion": "Normal",
        "side": "right",
        "text": "You can never be too prepared, {partner}. Keep your footwork sharp and you will never be caught off guard."
      }
    },
    {
      "id": "florges_knowing_glance",
      "say": {
        "speaker": "healer_parent",
        "emotion": "Worried",
        "side": "right",
        "text": "Go on, {healer}. Stay close to {lord} and {partner}, and practice your healing light well."
      }
    },
    {
      "id": "quaquaval_aside",
      "say": {
        "speaker": "mentor",
        "emotion": "Worried",
        "side": "right",
        "text": "(I have known since the day I found {lord}'s egg... Something ancient stirs inside that child, and {lord} must know how to fight.)"
      },
      "actions": [{ "type": "face", "who": "mentor", "toward": "lord" }]
    }
