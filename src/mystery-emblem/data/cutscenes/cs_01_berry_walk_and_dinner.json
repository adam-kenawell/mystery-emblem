      "actions": [{ "type": "emote", "who": "healer_parent", "emote": "heart", "duration": 1 }]
    },
    {
      "id": "after_dinner_shift",
      "say": {
        "speaker": "mentor",
        "emotion": "Determined",
        "side": "right",
        "text": "Now that every bowl is clean, grab your gear and meet me out on the training pitch, all three of you."
      },
      "actions": [{ "type": "walk", "who": "mentor", "path": [[7, 5]], "speed": 2.4, "facing": "Down" }]
    },
    {
      "id": "quaxly_surprised",
      "say": {
        "speaker": "partner",
        "emotion": "Surprised",
        "side": "left",
        "text": "Combat drills right after dinner?! Why the sudden rush, Dad?"
