        "speaker": "mentor",
        "emotion": "Happy",
        "side": "left",
        "text": "Haha, pace yourself, {partner}. Plenty for all five of us, though {lord} looks ready to eat the ladle too."
      }
    },
    {
      "id": "flabebe_dinner",
      "say": {
        "speaker": "healer",
        "emotion": "Joyous",
        "side": "right",
        "text": "Mom's herb bread makes everything better! Even {partner}'s bragging."
