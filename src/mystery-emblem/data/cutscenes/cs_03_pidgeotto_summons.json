      "id": "mountain_warning",
      "say": {
        "speaker": "lord",
        "emotion": "Determined",
        "side": "right",
        "text": "Reaching the capital will not be easy. We have to cross the treacherous mountain peaks standing between our valley and the crownlands. Let's get ready!"
