    },
    {
      "id": "kids_excited",
      "music": { "kind": "song", "song": "exploration_theme" },
      "say": {
        "speaker": "partner",
        "emotion": "Inspired",
        "side": "left",
        "text": "{lord}, can you believe it?! We are actually going to meet King Serperior in the royal capital! Though I still have no clue how Dad knows him!"
