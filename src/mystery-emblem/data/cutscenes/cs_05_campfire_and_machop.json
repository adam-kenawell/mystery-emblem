      "say": {
        "speaker": "machop",
        "emotion": "Happy",
        "side": "right",
        "text": "Boss Machamp got tied up clearing a rockslide on the high ridge! So I am guiding you through the mountain instead. I know a shortcut tunnel that gets us through fast!"
      },
      "actions": [{ "type": "pose", "who": "machop", "anim": "Attack", "duration": 0.45 }]
