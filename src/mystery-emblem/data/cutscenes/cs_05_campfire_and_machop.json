    {
      "id": "campfire_3",
      "say": {
        "speaker": "lord",
        "emotion": "Normal",
        "side": "left",
        "text": "What do you think it is, Dad? For the King to call back a retired Royal Guard after all these years, it has to be huge."
      }
    },
    {
      "id": "campfire_4",
      "say": {
        "speaker": "mentor",
        "emotion": "Normal",
        "side": "left",
        "text": "We will have our answers soon enough. Rest up tonight; my old contact Machamp promised a mountain guide at dawn."
      }
    },
    {
      "id": "morning_machop",
      "waitForActions": true,
      "music": { "kind": "song", "song": "fun_exploration" },
