      "actions": [{ "type": "emote", "who": "smoliv", "emote": "heart", "duration": 1 }]
    },
    {
      "id": "campfire_2",
      "say": {
        "speaker": "partner",
        "emotion": "Happy",
        "side": "right",
        "text": "The more the merrier, Smoliv! Especially once we see whatever grand mission King Serperior has waiting for Dad."
