        { "type": "place", "who": "lord", "x": 6, "y": 4, "facing": "Right" },
        { "type": "place", "who": "partner", "x": 6, "y": 6, "facing": "Right" },
        { "type": "place", "who": "healer", "x": 5, "y": 5, "facing": "Right" },
        { "type": "place", "who": "smoliv", "x": 5, "y": 6, "facing": "Right" },
        { "type": "fade", "to": "clear", "duration": 0.45 },
        { "type": "walk", "who": "machop", "path": [[9, 5]], "speed": 3.5, "facing": "Left" },
        { "type": "hop", "who": "machop", "count": 2 }
