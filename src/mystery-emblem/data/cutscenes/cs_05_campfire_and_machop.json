  "beats": [
    {
      "id": "campfire_1",
      "say": {
        "speaker": "smoliv",
        "emotion": "Happy",
        "side": "right",
        "text": "Warming my leaves by a real campfire with all of you feels like a dream... Thank you again for letting me tag along!"
