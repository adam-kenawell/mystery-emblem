    {
      "id": "line_1",
      "say": {
        "speaker": "lord",
        "emotion": "Worried",
        "side": "left",
        "text": "Deino isn’t cruel. He really believes Kingambit’s way is the only way to stop the Abyss."
      },
      "actions": [{ "type": "walk", "who": "lord", "path": [[7, 5]], "speed": 2.6, "facing": "Up" }]
    },
    {
      "id": "line_2",
      "say": {
        "speaker": "milotic",
        "emotion": "Sad",
        "side": "right",
        "text": "He lost his home the same night you did, {lord}. The sea brought you to Sir Empoleon. Ironscale found him."
      },
      "actions": [{ "type": "emote", "who": "milotic", "emote": "sweat", "duration": 1.05 }]
    },
    {
      "id": "line_3",
      "say": {
        "speaker": "mentor",
        "emotion": "Determined",
        "side": "left",
        "text": "Until the free kingdoms stand together, he’ll keep coming. Look sharp. A runner’s here."
      },
      "actions": [{ "type": "pose", "who": "mentor", "anim": "Attack", "duration": 0.48 }]
    },
    {
      "id": "line_4",
      "say": {
        "speaker": "partner",
        "emotion": "Determined",
        "side": "right",
        "text": "Whatever it is, we’re ready. And look what Deino dropped. This stone is warm!"
      },
      "actions": [
        { "type": "hop", "who": "partner", "count": 2 },
        { "type": "emote", "who": "healer", "emote": "heart", "duration": 1.1 }
      ]
    },
    {
      "id": "line_5",
      "say": {
        "speaker": "serperior",
        "emotion": "Determined",
        "side": "left",
        "text": "An Evolution Stone. Keep it safe. And this runner brings word: Ferals are raiding the Berry Orchards."
      },
      "actions": [{ "type": "pose", "who": "serperior", "anim": "Special", "duration": 0.52 }]
    },
    {
      "id": "line_6",
      "say": {
        "speaker": "advisor",
        "emotion": "Surprised",
        "side": "right",
        "text": "Our scouts also found a trail into Lush Prairie. Maybe someone out there needs help?"
      },
      "actions": [
        { "type": "shake", "who": "advisor", "duration": 0.5 },
        { "type": "emote", "who": "advisor", "emote": "exclamation", "duration": 1 }
      ]
    },
    {
      "id": "line_7",
      "say": {
        "speaker": "lord",
        "emotion": "Determined",
        "side": "left",
        "text": "Prairie or orchards, we’ll get to both. Nobody goes hungry on our watch."
      },
      "actions": [{ "type": "aura", "who": "lord", "duration": 1.2 }]
    }
  ]
