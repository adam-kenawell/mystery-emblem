---
/**
 * Crawlable info-page shell (About / How to Play / Characters / FAQ): PMD-styled window,
 * shared nav, "Play Now" call to action, and the fan-game disclaimer footer.
 */
import '@fontsource/fusion-pixel-12px-proportional-kr';
import '../mystery-emblem/ui/styles/00-reset.css';
import '../mystery-emblem/ui/styles/01-tokens-and-frames.css';
import SeoHead from '../components/SeoHead.astro';
import { AUTHOR_BLOG_URL, AUTHOR_NAME, INFO_PAGES } from '../siteMeta';

interface Props {
  title: string;
  description: string;
  heading: string;
  jsonLd?: ReadonlyArray<object>;
}

const { title, description, heading, jsonLd } = Astro.props;
const currentPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <SeoHead title={title} description={description} jsonLd={jsonLd} />
  </head>
  <body class="info-page">
    <header class="info-header">
      <a class="info-brand" href="/">Mystery Emblem</a>
      <nav class="info-nav" aria-label="Site">
        {
          INFO_PAGES.map((page) => (
            <a href={page.path} aria-current={page.path === currentPath ? 'page' : undefined}>
              {page.label}
            </a>
          ))
        }
      </nav>
    </header>

    <main class="info-main">
      <article class="pmd-window info-window">
        <h1>{heading}</h1>
        <slot />
        <p class="info-cta">
          <a class="pmd-btn pmd-btn-primary info-play-btn" href="/">Play Now - Free in Your Browser ▶</a>
        </p>
      </article>
    </main>

    <footer class="info-footer">
      <p>
        Made by {AUTHOR_NAME}. Follow development on the <a href={AUTHOR_BLOG_URL}>blog</a>.
      </p>
      <p>
        Mystery Emblem is a free, non-commercial fan game. It is not affiliated with or endorsed by
        Nintendo, The Pokémon Company, Game Freak, Creatures Inc., or Intelligent Systems. Pokémon and
        Fire Emblem are trademarks of their respective owners.
      </p>
    </footer>
  </body>
</html>

<style is:global>
  body.info-page {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    background: linear-gradient(180deg, #131130 0%, #1d1f48 22%, #132540 66%, #0b1424 100%);
    font-size: 16px;
    line-height: 1.6;
  }

  .info-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 20px;
    padding: 14px clamp(16px, 4vw, 40px);
  }

  .info-brand {
    color: var(--pmd-text-yellow);
    font-size: 20px;
    font-weight: bold;
    text-decoration: none;
  }

  .info-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
  }

  .info-nav a,
  .info-footer a,
  .info-window a:not(.pmd-btn) {
    color: var(--pmd-text-cyan);
  }

  .info-nav a {
    text-decoration: none;
  }

  .info-nav a:hover,
  .info-nav a[aria-current='page'] {
    color: var(--pmd-text-yellow);
    text-decoration: underline;
  }

  .info-main {
    flex: 1;
    width: min(820px, 100%);
    margin: 0 auto;
    padding: 8px clamp(10px, 3vw, 24px) 24px;
  }

  .info-window {
    padding: 18px clamp(16px, 4vw, 32px) 22px;
  }

  .info-window h1 {
    margin: 0 0 12px;
    color: var(--pmd-text-yellow);
    font-size: clamp(22px, 4vw, 30px);
    line-height: 1.25;
  }

  .info-window h2 {
    margin: 22px 0 6px;
    color: var(--pmd-text-gold);
    font-size: 20px;
  }

  .info-window h3 {
    margin: 14px 0 4px;
    color: var(--pmd-text-green);
    font-size: 17px;
  }

  .info-window p,
  .info-window ul,
  .info-window ol {
    margin: 0 0 10px;
  }

  .info-window ul,
  .info-window ol {
    padding-left: 1.4em;
  }

  .info-window li {
    margin-bottom: 4px;
  }

  .info-window strong {
    color: var(--pmd-text-yellow);
  }

  .info-figure {
    margin: 4px 0 16px;
  }

  .info-figure img {
    width: 100%;
    height: auto;
    display: block;
  }

  .info-cta {
    margin-top: 22px !important;
    text-align: center;
  }

  .info-play-btn {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    padding: 6px 18px;
    font-size: 17px;
    text-decoration: none;
  }

  .info-footer {
    padding: 8px clamp(16px, 4vw, 40px) 22px;
    color: #a8b8d0;
    font-size: 13px;
    text-align: center;
  }

  .info-footer p {
    max-width: 760px;
    margin: 0 auto 6px;
  }
</style>
